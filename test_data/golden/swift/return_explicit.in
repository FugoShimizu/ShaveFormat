func f() {
	a()
}

func g() -> Int { 1 }

func h() -> Never {
	fatalError()
}

class A {
	init() { b() }
	deinit { c() }
	var w: Int { get { return 1 } set { v = newValue } }
	var ignored: Int { get { return 1 } set {} }
	var named: Int { get { return 2 } set(newValue) {} }
	var observed: Int = 0 { willSet(next) {} didSet(old) {} }
