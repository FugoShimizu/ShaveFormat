struct Void {}
func userVoid() -> Void { Void() }
func standardVoid() -> Swift.Void { print(1) }
struct ResultNamespace {
	struct Void {}
	struct Never {}
}
func qualifiedUserVoid() -> ResultNamespace.Void { ResultNamespace.Void() }
func qualifiedUserNever() -> ResultNamespace.Never { ResultNamespace.Never() }

/**
 * 後判定の本体で終える
 * - Parameter c: 条件
 */
func postStop(_ c: Bool) {
	repeat {
		return
	} while c
}
