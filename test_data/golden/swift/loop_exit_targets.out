/**
 * 外側のループから脱出する
 */
func outerExit() -> Void {
outer:
	while true {
		while true {
			break outer
		}
	}
	return
}

/**
 * 内側のループだけを脱出する
 */
func innerExit() -> Void {
	while true {
	inner:
		while true {
			break inner
		}
	}
}

/**
 * 外側のループを継続する
 */
func outerContinue() -> Void {
outer:
	while true {
		while true {
			continue outer
		}
	}
}

/**
 * flag が真ならラベル付分岐を脱出する
 * - Parameter flag:
 */
func bypass(_ flag: Bool) -> Void {
outer:
	if flag {
		if flag {
			break outer
		}
		// 終了
		return
	} else {
		// 終了
		return
	}
	return
}

/**
 * ラベル付ループを処理する，x は分岐値
 * - Parameter x:
 */
func f(x: Int) {
search:
	for i in 0..<10 {
		switch x {
		case 1:
			break search
		default:
			break
		}
	}
	return
}

/**
 * ラベルとコメントを処理する
 */
func f() {
outer:
	/* note */ while true {
		break outer
	}
	return
}
