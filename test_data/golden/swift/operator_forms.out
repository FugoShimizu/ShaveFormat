/**
 *
 * - Parameter a:
 * - Parameter b:
 * - Parameter c:
 * - Returns:
 */
func f(_ a: Int, _ b: Int, _ c: Int) -> Int {
	let m = ~(1 << b), n = -(a >> b), o = (a << b) << c, p = (a + b) << c, q = a << (b + c), r = a << b & c
	return m + n + o + p + q + r
}

/**
 *
 * - Parameter alphaValue:
 * - Parameter bravoValue:
 * - Parameter charlieValue:
 * - Parameter deltaValue:
 * - Parameter echoValue:
 * - Parameter foxtrotValue:
 * - Returns:
 */
func compute(alphaValue: Int, bravoValue: Int, charlieValue: Int, deltaValue: Int, echoValue: Int, foxtrotValue: Int) -> Int {
	let total =
	alphaValue + bravoValue + charlieValue + deltaValue + echoValue + foxtrotValue + alphaValue + bravoValue + charlieValue +
	deltaValue + echoValue + foxtrotValue
	let flag =
	alphaValue > 0 && bravoValue > 0 && charlieValue > 0 && deltaValue > 0 && echoValue > 0 && foxtrotValue > 0 && alphaValue > 0 &&
	bravoValue > 0 && charlieValue > 0
	let picked = flag ?
	alphaValue + bravoValue + charlieValue + deltaValue + echoValue + foxtrotValue :
	alphaValue + bravoValue + charlieValue + deltaValue + echoValue + total
	return total + picked
}

