class C {
	/**
	 *
	 * - Parameter options:
	 */
	public init(options: WritingOptions = []) {
		self.options = options
		return
	}

	/**
	 *
	 * - Parameter items:
	 */
	public init(items: [Int] = [1, 2, 3]) {
		self.items = items
		return
	}
}

struct Config {
	/**
	 *
	 * - Parameter origin:
	 */
	init(origin: (Int, Int) = (0, 0)) {}
}

enum Kind {
	case entry(_ meta: [String: String] = [:])
}
