/**
 *
 * - Parameter x:
 * - Parameter y:
 * - Parameter xs:
 */
func f(x: Bool, y: Int, xs: [Int]) {
	if x {
		g()
	}
	while x {
		g()
	}
	guard x else {
		return
	}
	switch y {
	default:
		g()
	}
	repeat {
		g()
	} while x
	if (
		xs.contains {
			$0 > 1
		}
	) {
		g()
	}
	return
}

