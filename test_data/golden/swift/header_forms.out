 * - Parameter a:
 * - Parameter b:
 * - Parameter c:
 */
func h(a: [Int]?, b: [Int], c: Bool) {
	for x in a ?? b {
		g()
	}
	for x in c ? b : [] {
		g()
	}
	return
}

