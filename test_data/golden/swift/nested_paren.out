/**
 *
 * - Parameter a:
 * - Parameter b:
 * - Parameter c:
 * - Parameter p:
 * - Parameter x:
 * - Returns:
 */
func f(a: Int, b: Int, c: Int, p: [Int], x: Int?) -> Int {
	let y = (a + b) * c, z = p[b + c] * a, w = (x!)!
	return y + z + w
}

/**
 *
 * - Parameter x:
 * - Returns:
 */
func t(_ x: Int) throws -> Int {
	return x
}

let a = (try? t(1)) ?? 5
let dd: Int?? = 3
let b = (dd!)!

print(a, b)
