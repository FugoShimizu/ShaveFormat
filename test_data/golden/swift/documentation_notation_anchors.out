foo()

/**
 * 足す
 * - Parameter a: 左
 * - Parameter b:
 * - Parameter stale: 古い
 * - Returns:
 */
func add(_ a: Int, _ b: Int) -> Int {
	return a + b
}

/**
 * 表示する
 * - Returns: 無し
 */
func show() -> Void {}

/**
 *
 * - Parameter list:
 * - Returns:
 */
func pick(from list: [Int]) -> Int? {
	return list.first
}

struct InlineDocuments {
	/**
	 * Summary
	 * - Parameter a: A
	 * - Parameter b: B
	 * - Returns:
	 */ func inlineOrder(a: Int, b: Int) -> Int {
		return a + b
	}
}

func /**
 * Hello
 * - Parameter a:
 * - Returns:
 */ inlineFrame(_ a: Int) -> Int {
	return a
}

/**
 * A
 * ========== X ==========
 * B
 * - Parameter a: A value
 * - Parameter b: B value
 * - Returns:
 */
func sectionDocs(_ a: Int, _ b: Int) -> Int {
	return a + b
}

/**
 * A
