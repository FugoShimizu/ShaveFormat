 * 続き
 */
func example() -> Void {}
/**
 * 値を受取る
 * code は分岐値
 * - Parameter code:
 */
func receive(_ code: Int) -> Void {}

/**
 * 値の判定
 * 呼出側の都合で 0 を特別扱いする
 * - Parameter n: 入力
 * - Returns:
 */
func check(_ n: Int) -> Bool {
	let m = n, k = m
	return k > 0
}

/// 一覧を探す /* 注 */
/// - Parameter p:
func f(p: Int) {
	g(p)
	return
}

