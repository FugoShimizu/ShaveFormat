/**
 * 値の選択
 * - Parameter x: 候補
 * - Parameter y: 既定値
 * - Returns: 選んだ値
 */
func pick(x: Int? = nil, y: Int = 0) -> Int {
	// 選んだ値の返戻
	return x ?? y
}

let signedHex: Double = -0xA.FP+2
let upperExponent: Double = 0x1.AP-2
let binary: Int = 0b1010
let octal: Int = 0o17
