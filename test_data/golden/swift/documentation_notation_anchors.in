	g(p)
}

/** 説明 */
foo()

/// 足す
/// - Parameters:
///   - a: 左
///   - stale: 古い
func add(_ a: Int, _ b: Int) -> Int {
	return a + b
}

/// 表示する
/// - Returns: 無し
func show() -> Void {
}

func pick(from list: [Int]) -> Int? {
	return list.first
}

struct InlineDocuments {
/** Summary
 * - Parameter b: B
 * - Parameter a: A
 */ func inlineOrder(a: Int,b: Int) -> Int {return a+b}
}

func /** Hello */ inlineFrame(_ a: Int) -> Int {return a;}

/** A */
/** ========== X ========== */
/** B
 * - Parameter b: B value
 * - Parameter a: A value
 */
func sectionDocs(_ a: Int,_ b: Int) -> Int {return a+b;}

/** A */
/** ========== X ========== */
// B
func trailing() {}

// - Parameter Ghost:
