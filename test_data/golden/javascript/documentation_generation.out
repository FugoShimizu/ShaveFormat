/**
 * === rule_docgen_generate ===
 * @param a
 * @param b
 * @return
 */
function add(a, b) {
	return a + b;
}

/**
 *
 * @param message
 */
function logMessage(message) {
	console.log(message);
	return;
}

class Widget {
	/**
	 *
	 * @param id
	 */
	constructor(id) {
		this.id = id;
		return;
	}

	/**
	 *
	 * @param key
	 * @return
	 */
	find(key) {
		return this.lookup(key);
	}
}

/**
 * === rule_docgen_reconcile ===
 * 合計を求める
 * @param a 第一項
 * @param b
 * @param c
 * @param obsolete 余分な引数
 * @return 合計
 */
function total(a, b, c) {
	return a + b + c;
}
