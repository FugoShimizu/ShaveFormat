function eventLoop() {
	// 無限イベントループ
	for(;;) {
		const evt = queue.pop();
		if(!evt) break;
		dispatch(evt);
	}
}

function labeled() {
	// label 付き
	outer: for(;;) {
		for(const x of items) {
			if(done(x)) break outer;
		}
	}
}

function existingWhile() {
	// 既存の while(true) は不変
	while(true) doWork();
}

function forOf(items) {
	// for-of は対象外
	for(const x of items) use(x);
}

function regularFor(n) {
	// 通常 for は対象外
	for(let i = 0; i < n; ++i) use(i);
}

function LiteralWhile(){while(2){}}

function LiteralFor(){for(;0x2;){}}

function LiteralDo(){do{}while(-1);}

function LiteralFloat(){while(1.0){}}

function LiteralString(){while("x"){}}

function LiteralWrapped(){while(((2))){}}

function LiteralZero(){while(0){}}

function LiteralBreak(){while(2){break;}}
