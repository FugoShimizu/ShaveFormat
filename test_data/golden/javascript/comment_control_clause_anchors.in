}
function g(a, b) {
	if (a) {
		x();
		z();
	}
	// before bare else
	else y();
	if (a) {
		x();
		z();
	}
	// before else if
	else if (b) y();
	if (a) x();
	else {
		// 一つ目。二つ目
		y();
	}
}

async function f() {
	let /* note
	   more */ x = 1;
	x++;
	const v = await /* a
	 b */ g();
