		m();
	}
}

function SameLine() {
	try {
		g();
		h();
		// clause
	} catch {}
}
function NextLine() {
	try {
		g();
		h();
		// clause
	} catch {
	}
}

function f() {
	x();
	{ // bare
		y();
	}
	try { // t
		g();
	} catch(e) { // c
		k();
	} finally { // f
		m();
