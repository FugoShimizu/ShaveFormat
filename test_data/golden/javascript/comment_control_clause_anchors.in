	d */ x + v;
}

function map(elems, callback) {
	var i = 0, ret = [];
	if (isArray) {
		for (; i < elems.length; ++i) {
			ret.push(callback(elems[i]));
			count++;
		}
	// Go through every key on the object
	} else {
		for (i in elems) {
			ret.push(callback(elems[i]));
			count++;
		}
	}
	return ret;
}

function f() {
	a: b: for (;;) {
		g();
		// tail
	}
}

function f() {
	if (a) {
		g();
		h();
	} // d1
	// own
	else {
		k();
		m();
	}
	try {
		g();
		h();
	}
	// before catch
