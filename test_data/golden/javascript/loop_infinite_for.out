/**
 *
 */
function eventLoop() {
	// 無限イベントループ
	while(true) {
		const evt = queue.pop();
		if(!evt) break;
		dispatch(evt);
	}
	return;
}

/**
 *
 */
function labeled() {
// label 付き
outer:
	while(true) for(const x of items) if(done(x)) break outer;
	return;
}

/**
 *
 */
function existingWhile() {
	// 既存の while(true) は不変
	while(true) doWork();
}

/**
 *
 * @param items
 */
function forOf(items) {
	// for-of は対象外
	for(const x of items) use(x);
	return;
}

/**
 *
 * @param n
 */
function regularFor(n) {
	// 通常 for は対象外
	for(let i = 0; i < n; ++i) use(i);
	return;
}
