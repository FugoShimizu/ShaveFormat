/**
 * 統合候補関数
 * @param {boolean} isFirst 第一条件
 * @param {boolean} isSecond 第二条件
 */
function merge(isFirst, isSecond) {
	while(true) {
		if(isFirst) break;
		if(isSecond) break;
		break;
	}
	// 終了
	return;
}

/**
 * 条件内で書換える関数
 * @param x 条件値
 * @return 結果
 */
function conditionWrite(x) {
	// 結果
	if(x) return 1;
	// 結果
	if((x = true) && false) return 1;
	// 結果
	if(x) return 1;
	// 結果
	return 0;
}

/**
 * 観測される読取を重ねる関数
 * @param o 対象
 * @return 結果
 */
function siblings(o) {
	// 結果
	if(o.x) return 1;
	// 結果
	if(o.x) return 1;
	// 結果
	return 0;
}

/**
 * 観測される読取を分岐で重ねる関数
 * @param o 対象
 * @return 結果
 */
function alternatives(o) {
	// 結果
	if(o.x) return 1;
	// 結果
	else if(o.x) return 1;
	// 結果
	return 0;
}

/**
 * 定数条件を重ねる関数
 * @return 結果
 */
function literal() {
	// 結果
	if(false) return 1;
	// 結果
	if(false) return 1;
	// 結果
	return 0;
}

/**
 * トークンの境界の照合
 */
function tokenBoundaries() {
	if(a) z = x++ + y;
	if(b) z = x + ++y;
	if(a) z = x-- - y;
	else if(b) z = x - --y;
	if(a) {
		z = x++ + y;
		touch();
	}
	if(b) {
		z = x + ++y;
		touch();
	}
	if(a) {
		z = x-- - y;
		touch();
	} else if(b) {
		z = x - --y;
		touch();
	}
	if(a) z = x + y;
	else if(b) z = x + y;
	if(a) if(b) consume();
	if(a) if(b) if(c) consume();
	x += 1E0_1;
	x -= 1E+0_1;
	x += 1E-0_1;
	consume(x >= b + 1E0_1);
	consume(x <= b - 1E-0_1);
	consume(b + 1E+0_1 <= x);
	consume(b - 1E0_1 >= x);
	x += 1E0_0;
	consume(x >= b + 1E0_0);
	consume(x == 0E1_0);
	if(a) consume();
	if(b) consume();
	if(c) consume();
	if(a) consume();
	else if(b) consume();
	else if(c) consume();
	// 終了
	return;
}
