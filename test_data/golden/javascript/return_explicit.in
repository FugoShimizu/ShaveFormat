/**
 * 呼ぶ
 */
function f() {
	a()
}

/**
 * 分ける
 * @param x 値
 * @returns 値
 */
function g(x) {
	if (x) return 1;
}

/**
 * 生成する
 */
function* h() {
	yield 1;
}

/**
 * 後判定の本体で終える
 * @param c 条件
 */
function postStop(c) {
	do return;
	while(c);
}

/**
 * 属性の送出を捕捉して復帰する
 * @param value 対象
 */
function propertyInTry(value) { try { value.missing; return; } catch(e) { work(); } }

function outer() { function* g() { return 1; } g(); }
function outer2() { const g = function* () { return 1; }; g(); }
