// === rule_docgen_generate ===
function add(a, b) {
	return a + b;
}

function logMessage(message) {
	console.log(message);
}

class Widget {
	constructor(id) {
		this.id = id;
	}
	find(key) {
		return this.lookup(key);
	}
}

