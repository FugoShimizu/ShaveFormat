/**
 * 括弧付の更新対象を保持する関数
 * @return {number} 更新後の値
 */
function countUpdates() {
	let count = 0;
	count += 2;
	++count;
	++count;
	const values = [count];
	++values[0];
	// 更新結果の返戻
	return values[0];
}

