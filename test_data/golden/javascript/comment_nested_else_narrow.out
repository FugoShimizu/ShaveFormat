/**
 *
 * @param elems
 * @param callback
 * @return
 */
function map(elems, callback) {
	var i = 0, ret = [];
	if(isArray) {
		for(; i < elems.length; ++i) {
			ret.push(callback(elems[i]));
			++count;
		}
	// Go through every key on the object
	} else {
		for(i in elems) {
			ret.push(callback(elems[i]));
			++count;
		}
	}
	return ret;
}

if(conditionValue) {
	for(let i = 0; i < n; ++i) doWork(i);
} else doOther();

if(a) for(; i < n; ++i) {
	x();
	y();
// between branches
} else for(j in values) {
	z();
	w();
}

if(b) for(; i < n; ++i) {
	x();
	y();
} else for(j in values) {
	z();
	w();
}
