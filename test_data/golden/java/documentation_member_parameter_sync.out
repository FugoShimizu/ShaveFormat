// === rule_docgen_generate ===
class Calc {
	/**
	 *
	 * @param a
	 * @param b
	 * @return
	 */
	public int add(final int a, final int b) {
		return a + b;
	}

	/**
	 *
	 */
	void reset() {
		this.total = 0;
		return;
	}

	/**
	 *
	 * @param seed
	 */
	Calc(int seed) {
		this.total = seed;
		return;
	}
}

