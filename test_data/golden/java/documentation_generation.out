// === rule_docgen_generate ===
class Calc {
	/**
	 *
	 * @param a
	 * @param b
	 * @return
	 */
	public int add(final int a, final int b) {
		return a + b;
	}

	/**
	 *
	 */
	void reset() {
		this.total = 0;
		return;
	}

	/**
	 *
	 * @param seed
	 */
	Calc(int seed) {
		this.total = seed;
		return;
	}
}

// === rule_docgen_reconcile ===
class Geo {
	/**
	 * 面積を求める
	 * @param width 幅
	 * @param height
	 * @param stale 余分な引数
	 * @return 面積
	 */
	double area(double width, double height) {
		return width * height;
	}
}
