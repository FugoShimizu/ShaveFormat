float[] HexFloats = {0x1.p0f, 0x.8P0F, -0xA.p+2F, -0X.ap-2f};
double[] HexSuffix = {0X1.P0d, 0X.8P0D, -0xA.p+2D, -0X.ap-2d};
int[] IntegerBases = {0x1e2, 0XABC, 0b1010, 0B1100, 0755};
}
