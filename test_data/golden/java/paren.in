class Reader {
	static java.util.function.IntSupplier[] Values = { null, (() -> 1), (() -> 2) };
	/**
	 * 読込
	 * @param source 読込元
	 */
	<T extends Closeable & Readable> void read(T source) {
		try {
			source.close();
		} catch(IOException | RuntimeException e) {
			log(e);
		}
		// 終了
		return;
	}
}

