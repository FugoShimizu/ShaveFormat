class Dispatcher {
	/**
	 * 分岐値に応じて処理する
	 * @param code 分岐値
	 */
	static void Dispatch(final int code) {
		final Runnable run = () -> {
			return;
		};
		switch(code) {
		case 0:
			run.run();
			return;
		default:
			break;
		}
		return;
	}

	/**
	 * 値の取得関数
	 * @return 取得した値
	 */
	static int escapedReturn() {
		final int a = g();
		return \u0061;
	}

	/**
	 * 値の取得関数
	 * @return 取得した値
	 */
	static int formatCharacterReturn() {
		final int a‌ = g();
		return a;
	}
}
