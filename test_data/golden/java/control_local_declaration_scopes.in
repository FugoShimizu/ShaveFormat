class A {
	void f(boolean a, boolean b, boolean c) {
		if (a) if (b) x(); else { if (c) y(); } else z();
		if (a) { if (b) x(); } else z();
		if (a) { x(); } else if (b) { y(); } else { z(); }
	}
}

class A {
	void f(boolean a, boolean b) {
		if(a) if(b) x(); else y();
		while(a) do x(); while(b);
		if(a) x(); else do y(); while(b);
		if(a) { if(b) {} else {} }
		if(a) if(b) {} else {}
		if(a) { do {} while(b); }
		if(a) do {} while(b);
	}
}

class C { void f(boolean a, boolean b) { if(a) { if(b) { int x = read(); /* first */ int y = read(); /* second */ use(x, y); } } } }

class Registry {
	void register(String sourceText, int position, int languageMode, java.util.List<Integer> handlers) {
		if(position < sourceText.length() && sourceText.charAt(position) != '\n' && shouldBreakAfterExpandedBrace("\n}", sourceText.substring(position), languageMode)) handlers.add(position);
	}
}

class Reader {
	/**
	 * 読む
	 * @param path 経路
	 */
	void read(String path) {
		try {
			open(path);
		}
		catch (IllegalArgumentException e) {
			report(e);
		}
		catch (IllegalStateException e) {
			log(e);
		}
		finally {
			close();
		}
		return;
	}
}

class A {
	static final boolean RUN = true;

	/** 初期化部の同名の変数の後の定数条件の繰返 */
	void H() {
		for(int RUN = 0; RUN < 1; RUN++) {
			G();
		}
		while(RUN) {
			G();
		}
	}

	/**
	 * 仮引数が隠す定数条件の繰返
	 * @param RUN 続けるか
	 */
	void P(boolean RUN) {
		while(RUN) {
			G();
		}
	}

	/**
	 * 続けるかの判定
	 * @return 続けるか
	 */
	boolean G() {
		return true;
	}
}

class Worker {
	public void run() {
		// 無限 worker ループ
		for(;;) {
			Job job = queue.take();
			if(job == null) break;
			process(job);
		}
	}

	public void labeled() {
		// label 付き無限 for - label 付けても変換後 break label は valid
		outer:
		for(;;) {
			for(int i = 0; i < 10; ++i) {
				if(done(i)) break outer;
			}
		}
	}

	public void enhancedFor(int[] items) {
		// 拡張 for (foreach) は対象外
		for(int x : items) use(x);
	}

	public void existing() {
		// 既存の while(true) は不変
		while(true) doWork();
	}
}

class A {
	int f(int n) {
		int x = 0;
		int y = switch (n) {
			case 0 -> x++;
			default -> 1;
		};
		switch (n) {
			case 0 -> x++;
			default -> {}
		}
		return x + y;
	}
}

