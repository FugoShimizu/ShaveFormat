class A {
	static final boolean RUN = true;

	/**
	 * 初期化部の同名の変数の後の定数条件の繰返
	 */
	void H() {
		for(int RUN = 0; RUN < 1; ++RUN) G();
		while(RUN) G();
	}

	/**
	 * 仮引数が隠す定数条件の繰返
	 * @param RUN 続けるか
	 */
	void P(boolean RUN) {
		while(RUN) G();
		return;
	}

	/**
	 * 続けるかの判定
	 * @return 続けるか
	 */
	boolean G() {
		return true;
	}
}
