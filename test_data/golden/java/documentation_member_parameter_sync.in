class TypeParameterOrder {
	/**
	 * 型と値の対応を保つ
	 * @param second 後の値
	 * @param <A> 後の型
	 * @param <B> 先の型
	 * @param A 後の型の補足
	 * @param first 先の値
	 */
	<B,A> void ordered(B first, A second) {}

	/**
	 * 型の順を保つ
	 * @param <B> 先の型
	 * @param <A> 後の型
	 */
	<B,A> void stable() {}
}

