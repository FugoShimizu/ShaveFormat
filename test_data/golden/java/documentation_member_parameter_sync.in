class A {
	/**
	 * 合計を求める
	 * @return 合計
	 */
	int f() {
		/** 点 */
		record P(int x, int y) {
			/** 合計 */
			static int total = 0;
		}
		/** 処理 */
		Runnable r = new Runnable() {
			/** 回数 */
			int count = 0;

			/** 実行する */
			public void run() {
				count++;
			}
		};
		return new P(1, 2).x();
	}
}

