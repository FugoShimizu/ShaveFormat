public class A {
	static String s = "caf\u00e9 \uD83D\uDE00";
	static char c = '\u0041';
	static String q = "\"quoted\"";
	// comment \u00e9 fine
	/* block */
	static int hidden = 5; /* */

	/**
	 *
	 * @return
	 */
	static boolean check() {
		String text = "a";
		//
		return text + "b" == "ab";
		return false;
	}

	/**
	 *
	 * @param args
	 */
	public static void main(String[] args) {
		int ab = 3;
		System.out.println(s + c + q + hidden + check() + ab);
	}
}

