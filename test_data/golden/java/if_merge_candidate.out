class Candidate {
	/**
	 * 統合候補関数
	 * @param IsFirst 第一条件
	 * @param IsSecond 第二条件
	 */
	void Merge(final boolean IsFirst, final boolean IsSecond) {
		while(true) {
			if(IsFirst) break;
			if(IsSecond) break;
			break;
		}
		// 終了
		return;
	}

	/**
	 * トークンの境界の照合
	 */
	void TokenBoundaries() {
		if(A) Z = X++ + Y;
		if(B) Z = X + ++Y;
		if(A) Z = X-- - Y;
		else if(B) Z = X - --Y;
		if(A) {
			Z = X++ + Y;
			Touch();
		}
		if(B) {
			Z = X + ++Y;
			Touch();
		}
		if(A) {
			Z = X-- - Y;
			Touch();
		} else if(B) {
			Z = X - --Y;
			Touch();
		}
		if(A) Z = X + Y;
		else if(B) Z = X + Y;
		if(A) if(B) Consume();
		if(A) if(B) if(C) Consume();
		X += 1E0_1;
		X -= 1E+0_1;
		X += 1E-0_1;
		Consume(X >= B + 1E0_1);
		Consume(X <= B - 1E-0_1);
		Consume(B + 1E+0_1 <= X);
		Consume(B - 1E0_1 >= X);
		X += 1E0_0;
		Consume(X >= B + 1E0_0);
		Consume(X == 0E1_0);
		X += 0X1P1F;
		Consume(X >= B + 0X1P-1F);
		X -= 1E+0_1F;
		if(A) Consume();
		if(B) Consume();
		if(C) Consume();
		if(A) Consume();
		else if(B) Consume();
		else if(C) Consume();
		// 終了
		return;
	}
}
