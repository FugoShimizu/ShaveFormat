#
# @param v
# @return
def f(v)
	# before elsif
	# before end
	if v then a elsif w then b end
	return z
end

#
# @param a
# @return
def f(a)
	# shallow
	return (if a then g elsif b then h end)
end

#
# @param v
# @return
def f(v)
	case v when 1
		w
		z
	# when の注記
	end
	# elsif の注記
	if v then a elsif w then b end
	begin
		c
	rescue StandardError
		d
	# rescue の注記
	end
	return case v
	in Integer then e
	# in の注記
	end
end

#
# @return
def g
	return 1
rescue StandardError
	return 2
# def の rescue の注記
end

class Box
	# 配列の条件を比べる
	# @param alpha 対象の配列
	# @return 条件に合う呼出の値
	def count(alpha)
		alpha.each do |count|
			beta :a,
			[count, 3],
			note: "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau",
			count: 7 unless count.zero?
		end
		# 条件に合う値の返戻
		return (
			gamma :b,
			values: %i[a b c],
			note: "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu",
			count: 7 unless alpha.last == 7
		)
	end
end

