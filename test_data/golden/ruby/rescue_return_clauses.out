#
# @return
def output_value
	return puts "x"
end

#
# @return
def assignment_value
	return (x = 1)
end

#
# @return
def rescued_value
	begin
		return 1
	rescue
		return 2
	ensure
		h()
	end
end

#
# @return
def rescued_else
	begin
		1
	rescue
		return 2
	else
		return 3
	ensure
		h()
	end
end

#
# @return
def assignment_update
	return (x += 1)
end

#
# @return
def self.rescued_else
	1
rescue
	return 2
else
	return 3
ensure
	h()
end

# 読む
# @param path [String] 経路
# @return [String] 本文
def read(path)
	return load(path)
rescue ArgumentError => e
	return report(e)
rescue IOError => e
	return log(e)
ensure
	close
end

x = bar, foo rescue 1

#
# @param options
# @param name
# @return
def parse(options, name)
	opt = options[name] and (options[name] = Integer(opt)) rescue nil
	return options
end

#
# @return
def f
	g = -> { return 1 }
	return puts g.call
end

#
# @param a
# @return
def f(a)
	return(
		(+"x#{a}").tap do |s|
			s << "y"
		end
	)
end

#
# @param a
# @return
def g(a)
	return((+"x").concat(a))
end

#
# @param a
# @return
def h(a)
	return (a + 1).tap { |s| p s }
end

