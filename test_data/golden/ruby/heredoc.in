def squiggly_test
  sql = <<~SQL
      SELECT *
      FROM users
      WHERE id = 1
    SQL
  sql
end

def dash_test
  text = <<-EOT
      indented body
      more text
  EOT
  text
end

def plain_test
  text = <<EOT
not indented
body
EOT
  text
end

