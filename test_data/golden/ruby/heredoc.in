def guarded(ready)
  if ready
    consume <<~TEXT
epsilon
TEXT
  end
end

def sequential(first, second)
  if first
    consume_pair <<~FIRST, <<~EXTRA
first
FIRST
extra
EXTRA
  end
  if second
    consume <<~SECOND
second
SECOND
  end
  0
end

# 条件を満たさない場合の本文の処理関数
# @param ready 準備の状態
# @return 処理の結果
def explicit_guarded(ready)
  return ((unless ready
    consume_pair <<~FIRST, <<~SECOND
first
FIRST
second
SECOND
  end))
end

# 条件を満たす場合の本文の処理関数
# @param ready 準備の状態
# @return 終了の値
def yielded(ready)
  yield (if ready
    consume <<-TEXT.strip
value
TEXT
  end)
  return 0
end

collect {
  break (while ready
    consume <<~TEXT
loop
TEXT
  end)
}

collect {
  next (until done
    consume <<~TEXT
loop
TEXT
  end)
}
