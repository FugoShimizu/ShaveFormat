#
# @param a
# @param b
# @param c
# @return
def control_return(a, b, c)
	return (if a then b else c end)
	return (unless a then b else c end)
	return (b while a)
	return (b until a)
end

#
# @param a
# @param b
# @param c
# @return
def control_break(a, b, c)
	while a
		break (if a then b else c end)
		break (unless a then b else c end)
		break (b while a)
		break (b until a)
	end
	return 0
end

#
# @param a
# @param b
# @param c
# @return
def control_next(a, b, c)
	while a
		next (if a then b else c end)
		next (unless a then b else c end)
		next (b while a)
		next (b until a)
	end
	return 0
end

#
# @param a
# @param b
# @param c
# @return
def control_yield(a, b, c)
	yield (if a then b else c end)
	yield (unless a then b else c end)
	yield (b while a)
	yield (b until a)
	return 0
end

