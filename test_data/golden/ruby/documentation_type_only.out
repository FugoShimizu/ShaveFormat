# 足す
# @param a [Integer]
# @return [Integer]
def add(a)
	return a
end

# Finds
# @param a key
# @return [String] when found
# @return [nil] when missing
def find(a)
	return a
end

# Adds things
# @param a first
# @return [Integer] outer
# @overload add(x)
# @param x inner
# @return [Integer] inner
def over(a)
	return a
end

# Overloaded
# @param value outer input
# @return [Integer] outer result
# @overload typed(text)
# @param [String] text
# @return [String]
# @overload typed(count)
# @param [Integer] count
# @return [Integer]
def typed(value)
	return value
end
