#
# @param name
# @param age
# @param opts
def initialize(name:, age: 0, **opts)
	@name = name
	@age = age
end

#
# @param value
def name=(value)
	@name = value
end

#
# @return
def fetch
	yield(row, dry_run) if block_given?
	user&.id
	return obj&.method(arg)
end

#
# @param value
# @return
def parse_datetime(value)
	return nil if value.blank?
	return Time.zone.parse(value.to_s)
rescue ArgumentError
	return nil
end

h = { name: "alice", age: 30 }
proc = ->(x:, y: 1) { x + y }
