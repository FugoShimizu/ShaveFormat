class Config
	def maximum_retry_interval=(seconds)
		@maximum_retry_interval = seconds
	end

	def ==(other)
		return @maximum_retry_interval == other
	end

	def [](index)
		return @values[index]
	end
end

class Cmp
def <=>(other)
return other
end
