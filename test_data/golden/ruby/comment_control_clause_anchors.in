class Box
  # 配列の条件を比べる
  # @param alpha 対象の配列
  # @return 条件に合う呼出の値
  def count(alpha)
    alpha.each do |count|
      unless count.zero?
        beta :a, [count, 3], note: "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau", count: 7
      end
    end
    # 条件に合う値の返戻
    unless alpha.last == 7
      gamma :b, values: %i[a b c], note: "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu", count: 7
    end
  end
end

