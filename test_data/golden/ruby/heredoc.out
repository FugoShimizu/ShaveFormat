#
# @return
def squiggly_test
	sql = <<~SQL
      SELECT *
      FROM users
      WHERE id = 1
    SQL
	return sql
end

#
# @return
def dash_test
	text = <<-EOT
      indented body
      more text
  EOT
	return text
end

#
# @return
def plain_test
	text = <<EOT
not indented
body
EOT
	return text
end

