class Config
	#
	# @param seconds
	# @return
	def maximum_retry_interval=(seconds)
		return (@maximum_retry_interval = seconds)
	end

	#
	# @param other
	# @return
	def ==(other)
		return @maximum_retry_interval == other
	end

	#
	# @param index
	# @return
	def [](index)
		return @values[index]
	end
end

class Cmp
	#
	# @param other
	# @return
	def <=>(other)
		return other
	end
end

