open(T) do |f|
	while l = f.gets
		c1 = from_hex(c1)
		# # NFC TEST
		if c2 == Unicode.nfc(c1) && c2 == Unicode.nfc(c2) && c2 == Unicode.nfc(c3) && c4 == Unicode.nfc(c4) &&
			# #puts "NFC OK: " + code
			c4 == Unicode.nfc(c4) then else
			puts "NFC NG: " + to_hex(c1)
			printf(
				"  c2=%s NFC(c1)=%s NFC(c2)=%s NFC(c3)=%s\n",
				to_hex(c2),
				to_hex(Unicode.nfc(c1)),
				to_hex(Unicode.nfc(c2)),
				to_hex(Unicode.nfc(c3))
			)
		end
	end
end

# 条件に応じて数値を渡す
# @param box 対象の値
# @param count 条件の値
# @return 呼出の値
def alpha(box, count)
	return (
		if count then beta(
			box,
			"alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi",
			[1, 3, 7],
			count: count
		) else gamma(box, count: 0) end # 空の場合
	)
end

