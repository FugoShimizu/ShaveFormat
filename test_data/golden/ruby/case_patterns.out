# === case_in_pattern ===
# @param node
# @return
def match_pattern(node)
	return case node
	in { type: "leaf", value: } then handle_leaf(value)
	in { type: "branch", left:, right: } then handle_branch(left, right)
	else handle_unknown(node)
	end
end

short = case x
in 1 then :a
in 2 then :b
else :c
end

# === case_nested_when ===
# @param outer
# @param inner
# @return
def nested(outer, inner)
	return case outer when :a then case inner when 1 then :a1 when 2 then :a2 else :ax end
	when :b then case inner when 1 then perform_long_named_action_one(inner) when 2 then perform_long_named_action_two(inner)
		else perform_long_named_default(inner) end end
end

# === case_when_wrap ===
# @param value
# @return
def classify(value)
	return case value when 1 then "one" when 2 then "two" when 3 then "three" else "other" end
end

#
# @param v
# @return
def small(v)
	return case v when 1 then :a when 2 then :b else :c end
end

result = case status when :ok then perform_success_action_with_long_name(payload)
when :err then perform_error_action_with_long_name(payload) else perform_default_action_with_long_name(payload) end

case 7 when 1.. then
	p :a
	p :b
end
