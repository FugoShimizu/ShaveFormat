@charset "iso-8859-1";
a:before{content:"\\"}
b:after{content:"/"}
c{d:e}
a {
	content: 'it\'s "x"';
}
.a {
  content: "a\
    b";
  grid-template-areas: "x y"
      "z w";
}

.a { /* c */
	color: red;
	margin: 0;
}
@media screen { /* m */
	.b {
		color: blue;
	}
}

@keyframes fade { 0% { opacity: 0; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
@keyframes slide { from { left: 0; } to { left: 100%; } }
@-webkit-keyframes spin { 0% { transform: rotate(0); } 100% { transform: rotate(360deg); } }

/*
~~~text
50
%
~~~
*/
@keyframes fade { from, 50.5%, to { opacity: 0; } 1e+1%, .5e+2%, 100% { opacity: 1; } }

.literal {content: "begin\n";}
