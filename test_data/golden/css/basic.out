.card {
	display: flex;
	flex-direction: column;
	padding: 12px 8px;
/* card close */
}

.card .title {
	font-weight: bold;
	color: #333;
}

@media (max-width: 600px) {
	.card {
		padding: 8px 4px;
	}
}

.space > * + * {
	margin-top: calc(.5rem*(1 - var(--x)));
	margin-bottom: calc(1rem*(2) * (3));
	padding: calc(1em*var(--y));
}
