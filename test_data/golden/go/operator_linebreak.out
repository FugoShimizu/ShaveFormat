package main

func Compute(alphaValue int, bravoValue int, charlieValue int, deltaValue int, echoValue int, foxtrotValue int) int {
	total := alphaValue + bravoValue + charlieValue + deltaValue + echoValue + foxtrotValue + alphaValue + bravoValue +
	charlieValue + deltaValue + echoValue + foxtrotValue
	flag := alphaValue > 0 && bravoValue > 0 && charlieValue > 0 && deltaValue > 0 && echoValue > 0 && foxtrotValue > 0 &&
	alphaValue > 0 && bravoValue > 0 && charlieValue > 0
	if flag {
		return total
	}
	return total + alphaValue
}
