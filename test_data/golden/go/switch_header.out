package p

// Expression
func Expression(Value int) int {
	Count := 0
	switch X := Value + 1; X {
	case 1:
		Count = 2
	case 2:
		Count = 3
	default:
		Count = 4
	}
	return Count
}

// Condition
func Condition(Value int) int {
	switch X := Value + 1; {
	case X > 1:
		return X
	default:
		return 0
	}
}

// Type
func Type(Value any) int {
	switch Copy := Value; X := Copy.(type) {
	case int:
		return X
	case string:
		return len(X)
	default:
		return -1
	}
}

// Falling
func Falling(Value int) int {
	Count := 0
	switch X := Value; X {
	case 1:
		Count++
		fallthrough
	case 2:
		Count += 2
	case 3:
	default:
		Count = 4
	}
	return Count
}

// Initializer
func Initializer() int {
	switch X := (func() int {
		return 2
	})(); X {
	case 2:
		return X
	default:
		return 0
	}
}

// F
func F(x int) {
	switch x {
	case 1:
		if x > 0 {
			println(x)
		}
	case 2:
		println(x)
	default:
		println(0)
	}
	return
}
