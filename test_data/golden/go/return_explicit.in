// selectReturn
func selectReturn(c chan int) {
	select {
	case <-c:
		return
	}
}

// selectBreak
func selectBreak(c chan int) {
	select {
	case <-c:
		break
	}
}

// selectEmpty
func selectEmpty() {
	select {}
}

