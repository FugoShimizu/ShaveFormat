func Kind(Value any, Items []int) int {
	switch Copy := (Value).(type) {
	case int:
		return Copy
	}
	Total := 0
	for _, Item := range (Items) {
		Total += Item
	}
	return Total
}

func f(x, y int) int {
	return -(-x) + ^(-x) - (+y) + y*(-x)
}

// f は値を返す
func f(a int) int {
	return - -a + - - -a
}
