fun g(items: List<Int>, c: Boolean): Int {
    var next = 0
    items.forEach { next++ }
    val a = items.map { next++ }
    val r = if (c) { next++ } else { 0 }
    val w = when (c) { true -> { next-- } else -> 0 }
    lateinit var s: String
    next++
    return r + w + a.size
}
