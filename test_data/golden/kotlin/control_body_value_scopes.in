/**
 * do 本体のループを処理する
 * @param N 初期値
 */
fun G(N: Int) {
	var X = N
	do {
		while(X > 0) {
			--X
		}
	} while(X > 0)
	// 終了
	return
}

fun register(sourceText: String, position: Int, languageMode: Int, handlers: MutableList<Int>) {
	if(position < sourceText.length && sourceText[position] != '\n' && shouldBreakAfterExpandedBrace("\n}", sourceText.substring(position), languageMode)) handlers.add(position)
}

