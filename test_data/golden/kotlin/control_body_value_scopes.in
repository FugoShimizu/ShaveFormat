/**
 * 値を捨てる本体と値を返す枝を区別する
 * @param c 継続条件
 * @param xs 反復対象
 */
fun PostfixBodies(c: Boolean, xs: List<Int>): Unit {
    var y: Int = 0
    if(c) y++ else y--
    if(c) { y++ } else { y-- }
    while(c) y++
    while(c) { y++ }
    for(z: Int in xs) y--
    for(z: Int in xs) { y-- }
    do y++ while(c)
    do { y++ } while(c)
    if(c) while(c) y--
    val r: Int = if(c) y++ else y--
    // 終了
    return
}

