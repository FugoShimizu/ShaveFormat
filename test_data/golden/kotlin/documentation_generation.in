/**
 * 値を倍にする
 * @param value 入力値
 * @param extra 余分
 * @return 倍化結果
 */
fun double(value: Int): Int {
	return value * 2
}

fun compute(alpha: List<Int> = listOf(1)): Int {
	return alpha.size
}
