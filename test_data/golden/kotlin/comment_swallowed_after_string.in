fun g(flag: Boolean, b: String) {
    val url = "https://api.example.com/${b}"
    /* dispatch */
    when (b) {
        "x" -> println(url)
    }
    var q = "SELECT * FROM t"
    /* guard */
    !flag
    println(q)
    val r = """raw"""
    /* after raw */
    when (r) {
        else -> println(r)
    }
}
