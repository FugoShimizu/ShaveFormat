/**
 * 包む
 * @param T 要素の型
 * @param value 値
 * @return 包んだ値
 */
fun <T> wrap(value: T): T {
	return value
}

/**
 * 式の結果
 * @return 既存の結果
 */
fun exprResult() = readValue()
/**
 * 無値
 */
fun noValue(): Unit {}

/**
 * 戻らない
 */
fun halt(): Nothing {
	throw IllegalStateException()
}

/**
 * 型と値の対応を保つ
 * @param B 先の型
 * @param <A> 後の型
 * @param A 後の型の補足
 * @param first 先の値
 * @param second 後の値
 */
fun <B, A> ordered(first: B, second: A) {}
/**
 * First
 * Second
 * @param a Alpha
 */
fun docBoundary(a: Int): Unit {}
/**
 * Summary
 * @param class Value
 */
fun quoted(`class`: Int): Unit {}
/**
 * Summary
 * @param `a b` Value
 */
fun quotedSpace(`a b`: Int): Unit {}

/**
 * Summary
 * @param a A
 * @param b B
 * @return
 */ fun inlineOrder(a: Int, b: Int): Int {
	return a + b
}

fun /**
 * Hello
