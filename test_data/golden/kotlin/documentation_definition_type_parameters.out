 */ inlineFrame(a: Int): Int {
	return a
}

/**
 * A
 * ========== X ==========
 * B
 * @param a A value
 * @param b B value
 * @return
 */
fun sectionDocs(a: Int, b: Int): Int {
	return a + b
}

/**
 * A
