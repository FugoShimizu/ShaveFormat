/**
 *
 */
fun h() {
	g(a / (b * c))
	g(a % (b * c))
	g(a * (b % c))
	g(a - (b + c))
	g(a - (b - c))
	g(a - b * c)
	g(a * (b + c))
	g(a + b - c)
	g(a * b % c)
	g(a - (b + c) * d)
	g(a / (b * c))
	g(a + b)
	g(a && (b || c))
	g(a || b && c)
	g(a && (b && c))
	g(a || (b || c))
	g(a && b && c)
	g(a && (b || c) || d)
	g(a && b || c)
	g(1 to (2 to 3))
	g(1 to 2 to 3)
	g(x shl (y or z))
	g(a + (b to c))
	g(y - -1)
	g(y - -x)
}

/**
 *
 * @param a
 * @param b
 * @param c
 * @param p
 * @return
 */
fun f(a: Int, b: Int, c: Int, p: IntArray): Int {
	val x = (a + b) * c
	val y = p[b + c] * a
	return x + y
}
