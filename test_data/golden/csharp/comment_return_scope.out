class Dispatcher {
	/**
	 * <summary>分岐値に応じて処理する</summary>
	 * <param name="Code">分岐値</param>
	 */
	static void Dispatch(int Code) {
		switch(Code) {
		case 0:
			Run();
			return;
		default:
			break;
		}
		/**
		 * <summary>&lt;summary&gt;処理する&lt;/summary&gt;</summary>
		 */
		void Run() {
			return;
		}
		return;
	}

	/**
	 * <summary>値の取得関数</summary>
	 * <returns>取得した値</returns>
	 */
	static int EscapedReturn() {
		int a = G();
		return @a;
	}

	/**
	 * <summary>値の取得関数</summary>
	 * <returns>取得した値</returns>
	 */
	static int UnicodeDeclaration() {
		int \u0061 = G();
		return a;
	}

	/**
	 * <summary>値の取得関数</summary>
	 * <returns>取得した値</returns>
	 */
	static int LongEscapeReturn() {
		int a = G();
		return \U00000061;
	}

	/**
	 * <summary>値の取得関数</summary>
	 * <returns>取得した値</returns>
	 */
	static int FormatCharacterReturn() {
		int a‌ = G();
		return a;
	}
}
