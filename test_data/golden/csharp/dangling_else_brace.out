class A {
	/**
	 * <summary></summary>
	 * <param name="a"></param>
	 * <param name="b"></param>
	 * <param name="c"></param>
	 */
	void f(bool a, bool b, bool c) {
		if(a) {
			if(b) x();
			else if(c) y();
		} else z();
		if(a) {
			if(b) x();
		} else z();
		if(a) x();
		else if(b) y();
		else z();
		return;
	}
}

class A {
	/**
	 * <summary></summary>
	 * <param name="a"></param>
	 * <param name="b"></param>
	 */
	void f(bool a, bool b) {
		if(a) {
			if(b) x();
			else y();
		}
		while(a) {
			do x();
			while(b);
		}
		if(a) x();
		else {
			do y();
			while(b);
		}
		return;
	}
}
