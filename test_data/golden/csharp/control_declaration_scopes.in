class T { void F(int a) { if (a == 1) { int x = 1; } } }

class T { void F(int a) { if (a==1) { void Local(){} } } }

class A {
	void f(bool a, bool b, bool c) {
		if (a) if (b) x(); else { if (c) y(); } else z();
		if (a) { if (b) x(); } else z();
		if (a) { x(); } else if (b) { y(); } else { z(); }
	}
}

class A {
	void f(bool a, bool b) {
		if(a) if(b) x(); else y();
		while(a) do x(); while(b);
		if(a) x(); else do y(); while(b);
		if(a) { if(b) {} else {} }
		if(a) if(b) {} else {}
		if(a) { do {} while(b); }
		if(a) do {} while(b);
	}
}

class C { void F(bool a, bool b) { if(a) { if(b) { int x = Read(); /* first */ int y = Read(); /* second */ Use(x, y); } } } }

class Registry {
	void Register(string SourceText, int Position, int LanguageMode, System.Collections.Generic.List<int> Handlers) {
		if(Position < SourceText.Length && SourceText[Position] != '\n' && ShouldBreakAfterExpandedBrace("\n}", SourceText.Substring(Position), LanguageMode)) Handlers.Add(Position);
	}
}

class A {
	const bool Run = true;

	/// <summary>仮引数が定数を隠す繰返</summary>
	/// <param name="Run">続けるか</param>
	void F(bool Run) {
		while(Run) {
			Run = G();
		}
	}

	/// <summary>続けるかの判定</summary>
	/// <returns>続けるか</returns>
	bool G() {
		return true;
	}
}

class A {
	const bool Run = true;

	/// <summary>脱出の無い定数条件の繰返</summary>
	void H() {
		while(Run) {
			G();
		}
	}

	/// <summary>脱出の有る定数条件の繰返</summary>
	void F() {
		while(Run) {
			if(G()) {
				break;
			}
		}
	}

	/// <summary>続けるかの判定</summary>
	/// <returns>続けるか</returns>
	bool G() {
		return true;
	}
}

class Service {
	public void Run() {
		// 単純な無限ループ
		for(;;) {
			if(token.IsCancellationRequested) break;
			Process();
		}
	}

	public void Idempotent() {
		// 既存の while(true) は不変
		while(true) DoWork();
	}

	public void Foreach(int[] items) {
		// foreach は別 AST 種別の為対象外
		foreach(int x in items) Use(x);
	}

	public void RegularFor() {
		// 通常の for は対象外
		for(int i = 0; i < 10; ++i) Use(i);
	}
}
