using System;
namespace App {
	public class Foo {
		public static int Classify(int X) {
			if(X < 0) return -1;
			else if(X == 0) return 0;
			else if(X < 10) return 1;
			else return 2;
		}
		public void Nested(bool A, bool B) {
			if(A) {
				if(B) X = 1;
				else if(A != B) X = 2;
				else X = 3;
			}
		}
	}
}
