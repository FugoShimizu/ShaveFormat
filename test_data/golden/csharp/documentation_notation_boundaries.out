	 * <returns>出力</returns>
	 */
	int Read(int x) {
		return x;
	}
}

class NestedLine {
	/**
	 * <summary><![CDATA[<param name="z">例</param>]]></summary>
	 * <param name="x"><c>a,b</c>入力</param>
	 * <returns>出力</returns>
	 */
	int Read(int x) {
		return x;
	}
}

class CodeFirst {
	/**
	 * <code>x();</code>
	 * <summary>読む</summary>
	 * <param name="x">入力</param>
	 * <returns>出力</returns>
	 */
	int Read(int x) {
		return x;
	}

	/**
	 * <summary>再び読む</summary>
	 * <code>
	 * x();
	 * </code>
	 * <param name="x">入力</param>
	 * <returns>出力</returns>
	 */
	int ReadAgain(int x) {
		return x;
	}
}

