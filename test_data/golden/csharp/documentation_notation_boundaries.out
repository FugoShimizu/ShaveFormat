}

class Quoted {
	/**
	 * <remarks text="a >
	 * b">
	 * <![CDATA[<param name="data"/>]]>
	 * <param name="other"/>
	 * </remarks>
	 * <param
	 * name
	 * =
	 * "x">value</param>
	 */
	void F(int x) {}
}

