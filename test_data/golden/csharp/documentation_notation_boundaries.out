}

class SameLine {
	/**
	 * <summary>足す</summary>
	 * <param name="a">左</param>
	 * <param name="b">右</param>
	 * <returns>結果</returns>
	 */
	int Add(int a, int b) {
		return a + b;
	}
}

class JoinedSummary {
	/**
	 * <summary>前の説明
	 * 概要
