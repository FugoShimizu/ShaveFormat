class Calc {
	/// <summary>足す</summary>
	/// <param name="old">古い</param>
	int Add(int a, int b) {
		return a + b;
	}

	/// <inheritdoc/>
	public override string ToString() {
		return "";
	}

	async System.Threading.Tasks.Task<int> LoadAsync() {
		return await System.Threading.Tasks.Task.FromResult(1);
	}

	async System.Threading.Tasks.Task RunAsync(int n) {
		await System.Threading.Tasks.Task.Delay(n);
	}

	Calc(int seed) {
	}
}

class Deferred {
	async System.Threading.Tasks.ValueTask CompleteAsync() {
		await System.Threading.Tasks.Task.Delay(1);
	}

	async void NotifyAsync() {
		await System.Threading.Tasks.Task.Delay(1);
	}
}

class TypeParameterOrder {
	/// <summary>型と値の対応を保つ</summary>
	/// <param name="second">後の値</param>
	/// <typeparam name="A">後の型</typeparam>
	/// <typeparam name="B">先の型</typeparam>
	/// <typeparam name="A">後の型の補足</typeparam>
	/// <param name="first">先の値</param>
	void Ordered<B,A>(B first, A second) {}
}

class SummaryOrder {
// Before
/**
 * <summary>First</summary>
 * <summary>Second</summary>
 */
// After
void Multiple() {}

// Before
/** <summary>First</summary><summary>Second</summary> */
// After
void SameLine() {}

// Before
/** <summary role="first">First</summary> */
// After
/** <summary role="last">Second</summary> */
void Separate() {}

// Before
/// <summary>First</summary>
/** <summary>Second</summary> */
void Mixed(
// After
) {}

/** <summary>First<![CDATA[</summary>]]>Last</summary><!-- </summary> --> */
// After
void LiteralClosing() {}
}

class EscapedNames {
/**
 * <summary>Summary</summary>
 * <param name="class">Value</param>
 */
void F(int @class) {}
/**
 * <summary>Summary</summary>
 * <typeparam name="U">Second</typeparam>
 * <typeparam name="class">First</typeparam>
 */
void G<@class, U>() {}
}

class AttributeSummaryOrder {
// Before
/// <summary data="a
/// >b">First</summary>
/// <summary data='/>'>Second</summary>
// After
void Merge() {}
}

class InlineDocuments {
/** <summary>Summary</summary>
 * <param name="b">B</param>
 * <param name="a">A</param>
 */ int Ordered(int a,int b){return a+b;}
}

class SeparatedDocuments {
int /** <summary>Hello</summary> */ InlineFrame(int a){return a;}

/** <summary>A</summary> */
/** ========== X ========== */
/** <summary>B</summary>
 * <param name="b">B value</param>
 * <param name="a">A value</param>
 */
int SectionDocs(int a,int b){return a+b;}
}

class TrailingDescription {
/** <summary>A</summary> */
/** ========== X ========== */
// B
void trailing() {}
}

class ImplementationForms {
int Arrow(int x) => x;
/** <summary>C</summary><param name="x">X</param> */
ImplementationForms(int x) => Use(x);
/** <summary>D</summary> */
~ImplementationForms() {}
/** <summary>O</summary><param name="left">L</param><param name="right">R</param><returns>V</returns> */
public static ImplementationForms operator +(ImplementationForms left, ImplementationForms right) => left;
/** <summary>C</summary><param name="value">V</param><returns>R</returns> */
public static implicit operator int(ImplementationForms value) => 1;
/** <summary>Outer</summary> */
void Outer() {
/** <summary>S</summary><param name="old">Old</param><returns>R</returns> */
int Local(int x) { return x; }
int LocalArrow(int x) => x;
}
}

class LiteralDescriptions {
// A & B < C > D
void Plain() {}
// Before &lt;
/** <summary id="kept">Existing &amp; value</summary> */
// After < value
void Existing() {}
// Head & value
/** <summary id="empty"/> */
// Tail < value
void EmptySummary() {}
void Body() {
// Body & <value>
}
}

class Api {
	/// <summary>取得</summary>
	/// <param name="id">識別子</param>
	public void Get([FromQuery(Name = "id")] int id = 0) {
		Load(id);
		// 終了
		return;
	}
}

