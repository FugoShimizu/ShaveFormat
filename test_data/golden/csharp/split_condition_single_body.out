class Registry {
	/**
	 * <summary></summary>
	 * <param name="SourceText"></param>
	 * <param name="Position"></param>
	 * <param name="LanguageMode"></param>
	 * <param name="Handlers"></param>
	 */
	void Register(string SourceText, int Position, int LanguageMode, System.Collections.Generic.List<int> Handlers) {
		if(
			Position < SourceText.Length && SourceText[Position] != '\n' &&
			ShouldBreakAfterExpandedBrace("\n}", SourceText.Substring(Position), LanguageMode)
		) Handlers.Add(Position);
		return;
	}
}
