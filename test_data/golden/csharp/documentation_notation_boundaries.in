class A {
	/// <summary>足す</summary>
	/// <param
	///     name="a">値</param>
	/// <returns>結果</returns>
	public int Add(int a) {
		return a;
	}
}

class Outer {
/**
 * <remarks
 * >
 * <param name="other"/>
 * </remarks>
 */
void F(int x) {}
}

class Quoted {
/**
 * <remarks text="a >
 * b">
 * <![CDATA[<param name="data"/>]]>
 * <param name="other"/>
 * </remarks>
 * <param
 * name
 * =
 * "x">value</param>
 */
void F(int x) {}
}

class Unclosed {
/**
 * <param
 * <param
 * <param
 * <param
 */
void F(int x) {}
}

class SameLine {
	/// <returns>結果</returns><param name="b">右</param><summary>足す</summary><param name="a">左</param>
	int Add(int a, int b) {
		return a + b;
	}
}

class JoinedSummary {
	// 前の説明
	/// <param name="x">入力</param><summary>概要</summary><returns>出力</returns>
	// 後の説明
	int Read(int x) {
		return x;
	}
}

class NestedLine {
	/// <summary><![CDATA[<param name="z">例</param>]]></summary><param name="x"><c>a,b</c>入力</param><returns>出力</returns>
	int Read(int x) {
		return x;
	}
}

class CodeFirst {
	/// <code>x();</code><summary>読む</summary><param name="x">入力</param><returns>出力</returns>
	int Read(int x) {
		return x;
	}

	/// <summary>再び読む</summary><code>
	/// x();
	/// </code>
	/// <param name="x">入力</param><returns>出力</returns>
	int ReadAgain(int x) {
		return x;
	}
}

class EscapedValues {
	/// <summary>"a\"x  y" and 'a\'x  y'</summary>
	void Quotes() {}
	/// <summary><see cref="EscapedValues"/>. Next.</summary>
	void Elements() {}
}

/// <summary>
/// [First. Second.]
/// {First. Second.}
/// ［一文。二文。］
/// ｛一文。二文。｝
/// "a\"x. Next."
/// "a\"x  y"
/// <code>a.  b?</code>. next.
/// </summary>
class SentenceCases {}
