class A {
	/**
	 * <summary>値の出力関数</summary>
	 */
	void Print() {
		var Value = 1;
		System.Console.WriteLine(Value);
		// 終了
		return;
	}
}

namespace NamedType {
	class var {}

	class Factory {
		/**
		 * <summary>型の名前を推論の指定と区別する</summary>
		 * <returns>新しいインスタンス</returns>
		 */
		var Make() {
			return new var();
		}
	}
}
