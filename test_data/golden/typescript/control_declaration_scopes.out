/**
 *
 * @param X
 * @return
 */
function Classify(X: number): number {
	if(X < 0) return -1;
	else if(X === 0) return 0;
	else if(X < 10) return 1;
	else return 2;
}

/**
 *
 * @param A
 * @param B
 * @return
 */
function Nested(A: boolean, B: boolean): number {
	let X = 0;
	if(A) {
		if(B) X = 1;
		else if(A !== B) X = 2;
		else X = 3;
	}
	return X;
}

/**
 *
 * @param a
 * @return
 */
function f(a: number) {
	let n = 0;
	if(a > 0) {
		if(a) n = a;
		else n = 0;
	// 説明
	} else n = 2;
	return n;
}

import {
	alphaNumberWithLongName,
	type BetaNumberWithLongName,
	deltaNumberWithLongName,
	type GammaNumberWithLongName
} from "./box";

/**
 * 配列を作る
 * @param count 配列の長さ
 * @return 配列の組
 */
function alpha(count: number = 3): {
	alphaCountWithLongNeutralNameForWidth: number[],
	betaCountWithLongNeutralNameForWidth: number[]
} {
	const first: number[] = Array(count).fill(7), second: number[] = first.slice(1);
	if(!second.length) throw new Error("alpha has no values");
	// 配列の組の返戻
	return { alphaCountWithLongNeutralNameForWidth: first, betaCountWithLongNeutralNameForWidth: second };
}

