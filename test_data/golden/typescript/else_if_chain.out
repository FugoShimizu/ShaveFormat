/**
 *
 * @param X
 * @returns
 */
function Classify(X: number): number {
	if(X < 0) return -1;
	else if(X === 0) return 0;
	else if(X < 10) return 1;
	else return 2;
}

/**
 *
 * @param A
 * @param B
 * @returns
 */
function Nested(A: boolean, B: boolean): number {
	let X = 0;
	if(A) {
		if(B) X = 1;
		else if(A !== B) X = 2;
		else X = 3;
	}
	return X;
}
