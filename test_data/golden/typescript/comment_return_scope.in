/**
 * 分岐値に応じて処理する
 * @param code 分岐値
 */
function dispatch(code: number): void {
	const run = (): void => {
		return;
	};
	switch(code) {
	case 0:
		run();
		return;
	default:
		break;
	}
	return;
}

/**
 * 束縛の参照を区別する関数
 * @return 取得した値
 */
function arrowBinding(): number {
	const a: number = g((a: number): number => a);
	return a;
}

/**
 * 束縛の参照を区別する関数
 * @return 取得した値
 */
function asyncBinding(): number {
	const a: number = g(async (a: number): Promise<number> => a);
	return a;
}

/**
 * 束縛の参照を区別する関数
 * @return 取得した値
 */
function internalBinding(): number {
	const a: number = g(function a(): number { return 1; });
	// 値の返戻
	return a;
}

/**
 * 束縛の参照を区別する関数
 * @return 取得した値
 */
function capturedBinding(): number {
	const a: number = g((b: number): number => a);
	return a;
}
