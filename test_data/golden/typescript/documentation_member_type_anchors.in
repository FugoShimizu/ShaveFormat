/**
 * 生成する
 * @param o 値
 */
function f(o: {
	/** x */
	a: number
}): void {
	g(o);
}

/**
 * 混在
 * @param o 値
 */
function g(o: {
	/** first */
	// second
	a: number
}): void {}
/**
 * 初期値
 * @param o 値
 */
function h(o = {
	/** value */
	a: 1
}): void {}

interface Props {
	/** @deprecated use key */
	// TODO: rename
	id: string
}

interface PendingProcess {
	/** 値 */
	bytes: number;
	isQueued: boolean; // 待機
	tryStart(): boolean; // 起動
}

type T = {
	/** a の説明 */
	a: number;
	/** b の説明 */
	b: string;
};

enum Color {
	/** 赤 */
	RedColorValue,
	GreenColorValue,
	BlueColorValue,
	YellowColorValue,
	BlackColorValue,
	WhiteColorValue,
	PurpleColorValue,
	OrangeColorValue
}

/** 別名 */
export type Alias = string;

/** 名前空間 */
namespace N {
	/** 値 */
	export const y = 1;
}

declare global {
	/** 窓の値 */
	const x: number;
}

declare module "m" {
	/** 関数 */
	function f(): void;
}

/**
 * 型と値の対応を保つ
 * @param second 後の値
 * @template A 後の型
 * @template B 先の型
 * @template A 後の型の補足
 * @param first 先の値
 */
function ordered<B,A>(first: B, second: A): void {}

export const alpha: unknown = async (box?: {
  alphaCountWithLongName?: number[];
  /**
   */
  betaCountWithLongName?: number[];
  /** 値 */
  gammaCountWithLongName?: number[];
  deltaCountWithLongName?: number[];
}): Promise<number[] | undefined> => {
};

/**
 * Summary
 * @param {{x: number}} opts Options
 */
function nestedRecord(opts: object): void {}

/**
 * Summary
 * @arg {{x: number}} opts Options
 */
function nestedAlias(opts: object): void {}

/**
 * Summary
 * @param {Array<{x: number}>} opts Options
 */
function nestedArray(opts: object): void {}

/**
 * Summary
 * @param {function({x: number}): void} opts Options
 */
function nestedFunction(opts: object): void {}

/**
 * Summary
 * @param {{x: "}"}} opts Options
 */
function nestedQuote(opts: object): void {}

/**
 * Summary
 * @param a Value
 */
function escaped(\u0061: number): void {}

/**
 * Summary
 * @template U Second
 * @template T First
 */
function escapedTypes<\u0054, U>(): void {}

/**
 * Summary
 * @template U Second
 * @template {{x: number}} T First
 */
function nestedTypes<T, U>(): void {}

/** Summary
 * @param b B
 * @param a A
 */ function inlineOrder(a: number,b: number): number{return a+b;}

type LiteralUnion =
 | {k: 1; d: D}
 | {k: 2; d: D}
 /** union note */
 | {k: 3; d: D};

/**
 * Card
 * @param {Object} props Properties
 * @param {string} props.title Title
 * @return {string} Title
 */
function card({title, body}: {title: string; body: string}): string { return title; }

interface HeaderInterface
/** Interface header */
{ value: string; }

type HeaderAlias
/** Alias header */
= { value: string };

const headerValue
/** Value header */
= 1;
