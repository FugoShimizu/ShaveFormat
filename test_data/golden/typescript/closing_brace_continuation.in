import { clearHologramPatternCache, createHologramSurfaces, disposeHologramTextures, type HologramSettings, type HologramOptions } from "./acrylicHologram";

function createSqCanvas(color: string = "#000000", size: number = 512): { canvas: OffscreenCanvas, ctx: OffscreenCanvasRenderingContext2D } {
	const canvas = new OffscreenCanvas(size, size), ctx = canvas.getContext("2d", { willReadFrequently: true });
	if(!ctx) throw new Error("Canvas context is not available");
	return { canvas, ctx };
}

