#include <stdbool.h>

_Bool Scalar = { false };
bool Array[2] = { false, true };
_Bool Matrix[2][2] = { { false, true }, { true, false } };
bool Selected[2] = { [0] = true, [1] = { false } };
bool *Pointers[2] = { 0, 0 };

/**
 * 回す
 */
void f(void) {
	bool b = true;
	_Bool c = false;
	int d = 1;
	while(true) g(b, c, d);
	while(true) h();
}

#undef true

/**
 * 取り消した名前を生成しない
 * @return 偽の値
 */
int cancelled(void) {
	_Bool b = false;
	while(1) break;
	return b;
}

#include <stdbool.h>

#define true 0

#undef false

#define false 7

/**
 * 再定義の値を生成しない
 * @return １
 */
int redefined(void) {
	_Bool b = 0;
	int n = 0;
	while(1) {
		++n;
		break;
	}
	return n + b;
}

#undef true

#define true 1

#undef false

#define false 0

#if OPTION

#undef true

#define true 0

#endif

/**
 * 条件分岐後の未確定な名前を生成しない
 * @return 偽の値
 */
int conditional(void) {
	_Bool b = false;
	while(1) break;
	return b;
}
