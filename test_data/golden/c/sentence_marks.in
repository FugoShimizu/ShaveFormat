void f(void) {
	// 一文目？二文目！三文目。四文目
	// 疑問で終わる？
	// 感嘆で終わる！
	// 括弧の中（本当？）は分けない
	// あ？？い
	// 重要！！必ず読む
	// 本当に！？確認する
	// 末尾だけ！！
	int x = 1; // 行末は分けない？其の儘
	g(x);
}

void f(void) {
	// 甲？。！乙
	// 甲！。？乙
	// 甲。？！乙
	// 甲。。！乙
	// 甲！。。？乙
	// 甲。。乙
	// 甲。 ？乙
	// 。乙
	// ？乙
	// ！！！乙
	int x = 1;
	g(x);
}

void f(int *p) {
	// cppcheck-suppress nullPointer 理由。二文目
	*p = 1;
}
