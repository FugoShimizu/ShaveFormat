#pragma STDC FENV_ACCESS ON

/**
 * 浮動小数の変換結果の取得関数
 * @return 変換結果
 */
float ReadNormal(void) {
	const volatile float Value = 3.14;
	// 変換結果の返戻
	return Value;
}

