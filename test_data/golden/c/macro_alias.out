#include <stdio.h>

#define STR(x) #x

#define SS STR

#define SWAP(a, b) t = a; a = b; b = t

#define SWAP2 SWAP
#define M 0 || 5
#define N M

/**
 *
 * @return
 */
int main(void) {
	int t, a = 1, b = 2, x = 0;
	puts(SS(a + b));
	if(a) {
		SWAP2(a, b);
	}
	printf("%d\n", x && (N > 2));
	return 0;
}

#undef STR

#define STR(x) x

#undef M

#define M 5

#undef SWAP

void SWAP(int a, int b);

/**
 *
 * @param a
 * @param b
 * @param x
 */
void rebound(int a, int b, int x) {
	if(x) SWAP(a, b);
	if(x) SWAP2(a, b);
	x = x && N > 2;
	SS(a + b);
}

#define SWAP(a, b) a = b

/**
 *
 * @param a
 * @param b
 * @param x
 */
void redefined(int a, int b, int x) {
	if(x) SWAP2(a, b);
	return;
}
