/**
 * ゼロ比較の警告対象を並べた検査用関数
 * @param N 判定対象
 * @return 判定結果
 */
int Probe(int N) {
	// 制御条件の等値比較は !x を案内する
	if(N == 0) return 0;
	// 制御条件の非等値比較は x を案内する
	while(N != 0) --N;
	// 値文脈の０比較は真偽値を保持
	const int Flag = N == 0;
	// 返戻する
	return Flag;
}

/**
 * 値文脈を確認する
 * @param N 判定値
 * @return 判定結果
 */
int ProbeContexts(const int N) {
switch(N != 0) {
case 0: break;
default: break;
}
for(int Index = N != 0; Index; Index = N != 0) break;
const int Result = N ? N != 0 : 0;
// 判定結果の返戻
return Result;
}

/**
 * 非ゼロの値の更新関数
 * @param Value 値
 * @return 更新した値
 */
int ZeroCopy(int Value) {
	if(Value != 0) ++Value;
	// 更新した値の返戻
	return Value;
}

/**
 * 浮動小数の値の更新関数
 * @param Value 値
 * @return 更新した値
 */
double FloatZero(double Value) {
	if(Value != 0) Value = 1;
	// 更新した値の返戻
	return Value;
}

/**
 * トークンの境界の照合
 */
void TokenBoundaries() {
	if(A) Z = X++ + Y;
	if(B) Z = X + ++Y;
	if(A) Z = X-- - Y;
	else if(B) Z = X - --Y;
	if(A) {
		Z = X++ + Y;
		Touch();
	}
	if(B) {
		Z = X + ++Y;
		Touch();
	}
	if(A) {
		Z = X-- - Y;
		Touch();
	} else if(B) {
		Z = X - --Y;
		Touch();
	}
	if(A) Z = X + Y;
	else if(B) Z = X + Y;
	// 終了
	return;
}
