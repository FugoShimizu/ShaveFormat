void f() {
	for(;;) doThing();
}

void g() {
	for ( ; ; ) {
		doThing();
		if(stop) break;
	}
}

void h() {
	// 既存の `while(true)` は不変
	while(true) doThing();
}

void k() {
	// 通常の for は対象外
	for(int i = 0; i < 3; ++i) doThing(i);
}

/**
 * 回す
 */
void f(void) {
	bool b = 1;
	for(;;) g(b);
}

void LiteralWhile(){while(2){}}

void LiteralFor(){for(;0x2;){}}

void LiteralDo(){do{}while(-1);}

void LiteralFloat(){while(1.0){}}

void LiteralString(){while("x"){}}

void LiteralWrapped(){while(((2))){}}

void LiteralZero(){while(0){}}

void LiteralBreak(){while(2){break;}}
