/**
 * 符号の判定関数
 * @param Value 値
 * @return 符号付きの値
 */
int Signs(const int Value) {
	// 符号付きの値の返戻
	return -(-(-Value));
}

int f(int a, int b) {
	return - -a + + +b - - -b + - --a;
}
