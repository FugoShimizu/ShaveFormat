/**
 * 数値初期値と配列長の確認関数
 * @return 数値と配列長の合計
 */
double InspectNumbers(void) {
float Values[0xE0];
const float Hex = 0xE0, Other = 0x1e2, Negative = -0xE0;
const float Exact = 0x1p2, Fraction = 0x1.8p1;
const double Signed = -0x1.Ap0, Decimal = -.5;
// 数値と配列長の合計の返戻
return Hex + Other + Negative + Exact + Fraction + Signed + Decimal + sizeof(Values) / sizeof(Values[0]);
}

int SpacedNegative = - 1;
int SpacedPositive = + 1;
double SpacedDecimal = - 1.5;
int SpacedHex = - 0x1;
int ParenthesizedNegative = -(1);
int NestedNegative = - -1;

/**
 * 符号付きの被演算子の検査関数
 */
void InspectSignedOperands(void) {
Consume(- 1 > 0);
Consume(+ 1);
// 終了
return;
}

double HexDoubles[] = {0x1.p0, 0X.8P0, -0xA.p+2, -0X.8p-2, 0x1.Ap0, 0X1.fp0, 0xFp-2, -0x0.p0};
float HexFloats[] = {0x1.p0f, 0x.8P0F, -0xA.p+2F, -0X.8p-2f};
long double HexLongs[] = {0X1.P0l, 0X.8P0L, -0xA.p+2L, -0X.8p-2l};
int IntegerBases[] = {0x1e2, 0XABC, 0b1010, 0B1100, 0755};
