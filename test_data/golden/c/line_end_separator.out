/**
 * 区切りの例
 */
void Example(void) {
	First(); // none
	Second();	// mixed
	Third();		// two tabs
	Fourth();			// three tabs
	Fifth(1, /* inline */ 2);	// after inline
	Sixth();	// same
	Sixth();		// same
	// own line
	Seventh();	// tabbed body
	return;
}

/**
 * 統合の例
 */
