/**
 *
 * @param a
 * @param b
 * @param c
 */
void f(int a, int b, int c) {
	if(a) {
		if(b) x();
		else if(c) y();
	} else z();
	if(a) {
		while(c) if(b) y();
	} else z();
	if(a) {
	L:
		if(b) x();
	} else z();
	if(a) {
	M:
		if(b) x();
		else y();
	} else z();
	if(a) x();
	else y();
	if(a);
	else;
	while(a);
	return;
}

/**
 *
 * @param a
 * @param b
 */
void f(int a, int b) {
	if(a) {
		do x();
		while(b);
	}
	if(a) {
		do x();
		while(b);
	} else y();
	if(a) y();
	else {
		do x();
		while(b);
	}
	while(a) {
		do x();
		while(b);
	}
	if(a) {
		do g();
		while(b);
	} else h();
	if(a) {
		g();
		h();
	}
	while(b);
	do {
		g();
		h();
	} while(b);
	return;
}

/**
 *
 * @param SourceText
 * @param Position
 * @param SourceSize
 * @param LanguageMode
 * @param Handlers
 */
void Register(const char *SourceText, unsigned Position, unsigned SourceSize, unsigned LanguageMode, unsigned *Handlers) {
	if(
		Position < SourceSize && SourceText[Position] != '\n' &&
		ShouldBreakAfterExpandedBrace("\n}", SourceText + Position, LanguageMode)
	) Handlers[0] = Position;
	return;
}
