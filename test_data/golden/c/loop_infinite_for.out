/**
 *
 */
void f() {
	while(1) doThing();
}

/**
 *
 */
void g() {
	while(1) {
		doThing();
		if(stop) break;
	}
	return;
}

/**
 *
 */
void h() {
	// 既存の `while(true)` は不変
	while(true) doThing();
}

/**
 *
 */
void k() {
	// 通常の for は対象外
	for(int i = 0; i < 3; ++i) doThing(i);
	return;
}

/**
 * 回す
 */
void f(void) {
	bool b = 1;
	while(1) g(b);
}

/**
 *
 */
void LiteralWhile() {
	while(2) {}
}

/**
 *
 */
void LiteralFor() {
	for(; 0X2;) {}
}

/**
 *
 */
void LiteralDo() {
	do {} while(-1);
}

/**
 *
 */
void LiteralFloat() {
	while(1.0) {}
}

/**
 *
 */
void LiteralString() {
	while("x") {}
}

/**
 *
 */
void LiteralWrapped() {
	while(2) {}
}

/**
 *
 */
void LiteralZero() {
	while(0) {}
	return;
}

/**
 *
 */
void LiteralBreak() {
	while(2) break;
	return;
}
