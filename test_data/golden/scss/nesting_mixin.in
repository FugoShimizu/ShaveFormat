@use "sass:math" as *;
@use "sass:map" as m;
@forward "src/list" as list-*;
@forward "src/theme" show color, font;

$base: 8px;

@mixin flex($dir: row) {
	display: flex;
	flex-direction: $dir;
}

.card {
	@include flex(column);
	padding: $base * 2;
	> .title { font-weight: 700; }
	&:hover { opacity: .8; }
	.nested & { color: red; }
	// card close
}

.a { &#top { color: red; } }

.mapping-after {
 width: #{$base};
 > .child { color: red; }
}

.mapping-before {
 > .child { color: red; }
 width: #{$base};
}

@-moz-document url-prefix(){.probe{width:1px}}
@document url("https://example.test/"),url-prefix("https://sample.test/"){.probe{height:2px}}
.relative{.first,> .second,+ .third,~ .fourth{color:red}}

%shared-line{color:red;}
.existing-line{color:blue;}
.extending{@extend %shared-line;background:url(http://example.test/a);}
.extending-class{@extend .existing-line;}
