interface Props {
	items: { id: number; name: string }[];
}
export function List(props: Props): JSX.Element {
	return (
		<ul className="list">
			{props.items.map(item => (
				<li key={item.id}>
					<span>{item.name}</span>
					{item.id > 0 ? <span className="positive">+</span> : <span className="zero">0</span>}
				</li>
			))}
		</ul>
	);
}

/**
 * 数値の入力を表示する
 * @return 要素
 */
export function Box(): JSX.Element {
  // 要素の返戻
  return (
    <aside>
      <input
        value={alpha(3)}
        onChange={(): void => {
          count = 7;
          beta(count);
        }}
      />
      <p title={"alpha"}>x</p>
    </aside>
  );
}

