/**
 * トークンの境界の照合
 */
function tokenBoundaries(): void {
	if(a) z = x++ + y;
	if(b) z = x + ++y;
	if(a) z = x-- - y;
	else if(b) z = x - --y;
	if(a) {
		z = x++ + y;
		touch();
	}
	if(b) {
		z = x + ++y;
		touch();
	}
	if(a) {
		z = x-- - y;
		touch();
	} else if(b) {
		z = x - --y;
		touch();
	}
	if(a) z = x + y;
	else if(b) z = x + y;
	// 終了
	return;
}

