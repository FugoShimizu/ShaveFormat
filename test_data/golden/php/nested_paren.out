<?php

/**
 *
 * @param $a
 * @param $b
 * @param $c
 * @param $d
 * @param $e
 * @param $p
 * @return
 */
function f($a, $b, $c, $d, $e, $p) {
	$x = ($a + $b) * $c;
	$y = $p[$b + $c] * $a;
	return $a ? $b : ($c ? $d : $e);
}

foreach($a ?: $b as $v) echo $v;
foreach($a as $k => $v) echo $k;
foreach($a = $b as $v) echo $v;
