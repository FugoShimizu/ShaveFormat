/**
 *
 * @param $value
 * @return
 */
function classify($value) {
	if($value === 1) {
		firstOperationWithLongName($value);
		secondOperationWithLongName($value);
		thirdOperationName($value);
	} elseif($value === 2) {
		fallbackOperation($value);
		finalOperation($value);
	}
	return 0;
}

/**
 *
 * @param $sourceText
 * @param $position
 * @param $languageMode
 * @param $handlers
 */
function register($sourceText, $position, $languageMode, &$handlers) {
	if(
		$position < strlen($sourceText) && $sourceText[$position] !== "\n" &&
		shouldBreakAfterExpandedBrace("\n}", substr($sourceText, $position), $languageMode)
	) $handlers[] = $position;
	return;
}
