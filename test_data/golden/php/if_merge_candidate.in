<?php
declare(strict_types=1);

/**
 * 統合候補関数
 * @param bool $isFirst 第一条件
 * @param bool $isSecond 第二条件
 */
function merge(bool $isFirst, bool $isSecond): void {
	while(true) {
		if($isFirst) break;
		if($isSecond) break;
		break;
	}
	while(true) {
		if($isFirst) break;
		elseif($isSecond) break;
		break;
	}
	// 終了
	return;
}

/**
 * トークンの境界の照合
 */
function tokenBoundaries(): void {
	if($a) $z = $x++ + $y;
	if($b) $z = $x + ++$y;
	if($a) $z = $x-- - $y;
	else if($b) $z = $x - --$y;
	if($a) {
		$z = $x++ + $y;
		touch();
	}
	if($b) {
		$z = $x + ++$y;
		touch();
	}
	if($a) {
		$z = $x-- - $y;
		touch();
	} else if($b) {
		$z = $x - --$y;
		touch();
	}
	if($a) $z = $x + $y;
	else if($b) $z = $x + $y;
	if($a) { if($b) { consume(); } }
	if($a) if($b) if($c) consume();
	$x += 1E0_1;
	$x -= 1E+0_1;
	$x += 1E-0_1;
	consume($x >= $b + 1E0_1);
	consume($x <= $b - 1E-0_1);
	consume($b + 1E+0_1 <= $x);
	consume($b - 1E0_1 >= $x);
	$x += 1E0_0;
	consume($x >= $b + 1E0_0);
	consume($x == 0E1_0);
	if($a) consume();
	if($b) consume();
	if($c) consume();
	if($a) consume();
	else if($b) consume();
	else if($c) consume();
	// 終了
	return;
}
