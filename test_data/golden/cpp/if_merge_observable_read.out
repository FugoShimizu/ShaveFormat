/**
 *
 * @param p
 * @return
 */
int siblings(volatile int *p) {
	if(*p) return 1;
	if(*p) return 1;
	return 0;
}

/**
 *
 * @param p
 * @return
 */
int alternatives(volatile int *p) {
	if(*p) return 1;
	else if(*p) return 1;
	return 0;
}

/**
 *
 * @return
 */
int literal() {
	if(0) return 1;
	if(0) return 1;
	return 0;
}
