#include <cstdio>
#include <type_traits>
#include <bitset>
template <bool B> int tf(int v) { return B ? v : -v; }
template <typename T, std::enable_if_t<(sizeof(T) > 4), int> = 0> void g(T) {}
int main() {
	int y = tf<(3 > 2)>(5);
	std::bitset<(8 > 4)> b;
	std::bitset<(8)> c;
	std::printf("%d\n", y);
	return 0;
}
