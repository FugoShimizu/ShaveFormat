/**
 * 加算
 * ```text
 * @param fake 甲。乙
 * @return
 * ```
 * @param Second 第二値
 * ```text
 * second-description
 * ```
 * @param First 第一値
 * ```text
 * first-description
 * ```
 * @param obsolete 不要
 * @return 結果
 */
int Example(const int First, const int Second) { return First + Second; }

/**
 * | x | First. Second. |
 * > First. Second.
 * - First. Second.
 * `left | right`. Second.
 * ## First. Second.
 */
int Structured;
// <b>First</b>. Second.
// <see cref="C"/>. Next.
// <code>a.  b.</code>. Next.
// <summary>! Next.
// `x >. Next.`
int MarkupSentences;

/**
 * Protected examples
 * @code
 * int x; // @endcodex Alpha. Beta.
 * @endcode_more Alpha. Beta.
 * @endcode2 Alpha. Beta.
 * @endcode
 * After code. Next.
 * @verbatim
 * @endverbatimx Alpha. Beta.
 * @endverbatim
 * @dot
 * a -> b [label="First. Second."];
 * @enddotx Alpha. Beta.
 * @enddot
 * @msc
 * a,b;
 * a=>b [label="First. Second."];
 * @endmscx Alpha. Beta.
 * @endmsc
 * \code{.cpp}
 * // \endcodex Alpha. Beta.
 * \endcode
 * Formula: \f$\text{First.  Second.}\f$. After formula.
 * Display: \f[\text{First. Second.}\f].
 * Environment: \f{align}{\text{First. Second.}\f}.
 * Alternate: @f$\text{First. Second.}@f$.
 * Alternate display: @f[\text{First. Second.}@f].
 * Alternate environment: @f{align}{\text{First. Second.}@f}.
 */
void ProtectedExamples() {}

/**
@code
*p = f("First.  Second.");
**p = 2;
@endcode
*/
void UndecoratedCode() {}

/**
 *　@code
 *	*p = f("First.  Second.");
 * **p = 2;
 * @endcode
