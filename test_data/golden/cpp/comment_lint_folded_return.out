/**
 * 判定関数
 * @param Alpha 値
 * @return 条件の成否
 */
bool F(const int Alpha) {
	if(
		Alpha > 100000000000000000 || Alpha < -100000000000000000 || Alpha == 1234567890123456789 || Alpha == 987654321098765432 ||
		Alpha == 555555555555555555
	// 条件成立時の返戻
	) return true;
	if(
		Alpha > 200000000000000000 || Alpha < -200000000000000000 || Alpha == 2234567890123456789 || Alpha == 887654321098765432 ||
		Alpha == 666666666666666666
	) return true;
	// 不成立の返戻
	return false;
}
