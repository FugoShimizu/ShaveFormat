/**
 * 妥当性判定関数
 * @param Text 判定対象
 * @param Size 長さ
 * @return 全て読めれば true
 */
bool IsValid(const char *Text, unsigned Size) {
	for(unsigned Pos = 0; Pos < Size;) {
		unsigned Point = 0;
		if(!Decode(Text, Pos, Point)) return false;
	}
	// 全て読めた事の返戻
	return true;
}

/**
 * 合計関数
 * @param Size 件数
 * @return 合計
 */
int Sum(int Size) {
	int Total = 0;
	// 合計の返戻
	return Total + Size;
}

/**
 * 値の更新関数
 * @param Size 値
 * @return 更新した値
 */
int UpdateTotal(const int Size) {
	int Total = Size;
	++Total;
	// 更新した値の返戻
	return Total;
}

/**
 * 二つの値の合計関数
 * @param Size 値
 * @return 合計
 */
int PairSum(const int Size) {
	int Left = Size, Right = Size + 1;
	// 合計の返戻
	return Left + Right;
}

/**
 * 有効範囲の判定関数
 * @param Size 値
 * @return 外側の値
 */
int Shadow(const int Size) {
	int Value = Size;
	{
		int Value = 1;
		++Value;
	}
	// 外側の値の返戻
	return Value + Size;
}

/**
 * 作業列の更新関数
 */
void UpdatePending() {
	std::vector<int> Pending { 1 };
	Pending.push_back(2);
	Pending.pop_back();
	// 終了
	return;
}
