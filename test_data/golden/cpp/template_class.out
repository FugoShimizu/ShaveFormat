template<typename T> class Container {
public:

	/**
	 *
	 */
	Container() : Size(0) {}

	/**
	 *
	 * @param Item
	 */
	void Add(const T &Item) {
		if(Size < Capacity) Items[Size++] = Item;
		else if(CanGrow()) {
			Grow();
			Items[Size++] = Item;
		}
		return;
	}

private:

	T Items[100];
	int Size;
	int Capacity = 100;
};

/**
 *
 * @param Args
 */
template<typename ...T> void Forward(T ...Args) {
	Sink(Args...);
	int Count = sizeof...(T);
	Sink(std::forward<T>(Args)...);
	return;
}

[...xs = args] {}();

template<class ...Ts> struct T : public Ts... {};
