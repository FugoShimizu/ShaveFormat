/**
 * 使用位置の定義と取消だけで括弧を判断する
 * @param Name 値
 * @param Function 呼出先
 * @return 使用位置で保持した値の和
 */
int MacroNamePosition(int Name, int (*Function)(int)) {
	#undef Name
	#undef Function
	const int Before = (Name);
	(Function)((Name));
	struct FunctionReceiver { int (*Invoke)(int); };
	const struct FunctionReceiver Receiver = { Function };
	(Receiver.Invoke)((Name));
	#define Invoke(Value) Value
	(Receiver.Invoke)(Name);
	#undef Invoke
	(Receiver.Invoke)((Name));
	#define Name 7
	const int During = (Name);
	#undef Name
	const int After = (Name);
	#if 0
	#define Name 8
	#endif
	const int Inactive = (Name);
	#if Name
	#endif
	const int Condition = (Name);
	#define Function(Value) Value
	(Function)(Name);
	#undef Function
	Function((Name));
	// 値の和の返戻
	return Before + During + After + Inactive + Condition;
}

/**
 * 呼出先の前処理の状態で実引数の括弧を判断する
 */
void CallArgumentStates() {
	RAW_CALL((((1 + 2))));
	raw_call((((1 + 2))));
	MixedCall((((1 + 2))));
	RAW_CALL((1 + 2), 3, (4 + 5));
	Api::RAW_CALL((1 + 2));
	#define raw_call(Value) Value
	raw_call((1 + 2));
	#define RAW_CALL raw_call
	RAW_CALL((1 + 2));
	#undef raw_call
	raw_call((1 + 2));
	RAW_CALL((1 + 2));
	#include "unread.h"
	#undef RAW_CALL
	#if CHOICE
	#define RAW_CALL(Value) Value
	#endif
	RAW_CALL((1 + 2));
	#undef RAW_CALL
	RAW_CALL((1 + 2));
	// 終了
	return;
}

#include "unread.h"

/**
 * 未読のインクルード後の実引数の括弧を保つ
 */
void IncludedCallArguments() {
	RAW_CALL((1));
	raw_call((1));
	MixedCall((1));
	// 終了
	return;
}

