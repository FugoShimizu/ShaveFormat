void MacroUpdates(int x,int i,int j,int *a,int *b){
x++;
#define x i + j
x++;
x--;
for(;i<3;x++) i=3;
for(;i<3;x--) i=3;
#undef x
#define x *a
(x)++;
for(;i<3;(x)--) i=3;
#undef x
x++;
x--;
#define GET() i + j
GET()++;
GET()--;
for(;i<3;GET()++) i=3;
for(;i<3;GET()--) i=3;
#undef GET
#define A a + b
A[0]++;
A[0]--;
for(;i<3;A[0]++) i=3;
for(;i<3;A[0]--) i=3;
#undef A
#define x -i
x++;
x--;
#undef x
return;
}

struct Holder {int i;};
void MacroField(struct Holder s,int i,int j){
#define field i + j
s.field++;
s.field--;
for(;i<3;s.field++) i=3;
for(;i<3;s.field--) i=3;
#undef field
}

#define lowercase i + j
int MacroValue(int i,int j){return (lowercase);}
#undef lowercase

void MacroTyped(int *p,int &r,int i,int j){
#define p i + j
p++;
#undef p
#define r *p
(r)--;
#undef r
#define int long
int value;
value++;
#undef int
}

void ConditionalMacro(int replacement,int i,int j){
#if CHOICE
#define replacement i + j
#else
#define replacement j
#endif
replacement++;
for(;i<3;replacement--) i=3;
#undef replacement
return;
}

struct MacroCounter {
MacroCounter &operator++();
MacroCounter operator++(int);
MacroCounter &operator--();
MacroCounter operator--(int);
};
void MacroOverload(int x,int *p,int &r){
MacroCounter y;
#define x y
x++;
(x)++;
for(int i=0;i<2;(x)--) i=2;
#undef x
#define p y
p++;
#undef p
#define r y
(r)--;
#undef r
return;
}

