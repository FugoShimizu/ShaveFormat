/**
 *
 * @param x
 * @param y
 * @return
 */
int siblings(Flag x, Flag y) {
	if(x) return 1;
	if(y) return 1;
	return 0;
}

/**
 *
 * @param x
 * @param y
 * @return
 */
int alternatives(Flag x, Flag y) {
	if(x) return 1;
	else if(y) return 1;
	return 0;
}

/**
 *
 * @param x
 * @param y
 * @return
 */
int nested(Flag x, Flag y) {
	if(x) if(y) return 1;
	return 0;
}

/**
 *
 * @param x
 * @return
 */
int shadowed(int x) {
	{
		Flag x;
		if(x) if(x) return 1;
	}
	return 0;
}

/**
 *
 * @return
 */
int temporary() {
	if(MakeFlag()) return 1;
	if(Released()) return 1;
	return 0;
}

namespace Names {
	using size_t = Flag;

	/**
	 *
	 * @param x
	 * @param y
	 * @return
	 */
	int alias(size_t x, size_t y) {
		if(x) return 1;
		if(y) return 1;
		return 0;
	}
}

/**
 *
 * @param é
 * @return
 */
int unicode(int é) {
	{
		Flag \u00E9;
		if(é) if(é) return 1;
	}
	return 0;
}

/**
 *
 * @param x
 * @return
 */
int local_class(int x) {
	struct Local {
		Flag x;

		int y = [this] {
			if(x) if(x) return 1;
			return 0;
		}();
	};
	return Local{}.y;
}

/**
 *
 * @param x
 * @return
 */
int paren_decl(int x) {
	{
		Flag(x);
		if(x) if(x) return 1;
	}
	return 0;
}

namespace Enums {
	enum E { x = 1 };

	/**
	 *
	 * @return
	 */
	bool operator&&(E, E) {
		return false;
	}

	/**
	 *
	 * @param x
	 * @return
	 */
	int imported(int x) {
		{
			using enum E;
			if(x) if(x) return 1;
		}
		return 0;
	}
}

/**
 *
 * @param x
 * @return
 */
int anonymous_union(int x) {
	{
		union {
			Flag x {};
		};
		if(x) if(x) return 1;
	}
	return 0;
}
