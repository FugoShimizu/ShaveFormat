int Switch(int X) {
	switch(X) {
		case 1: return 10;
		case 2:
			Setup();
			return 20;
		case 3: {
			const int Tmp = X * 2;
			return Tmp;
		}
		default:
			return 0;
	}
}

void Move(int Viewpoint) {
	switch(Viewpoint) {
	case 0:
		A();
		return;
	case 1:
		B();
		return;
	}
}

void Stay(int Viewpoint) {
	switch(Viewpoint) {
	case 0:
		A();
		break;
	case 1:
		B();
		return;
	}
}
