/**
 * 統合候補関数
 * @param X 第一条件
 * @param Y 第二条件
 */
void Merge(Flag X, Flag Y) {
	while(true) {
		if(X) if(Y) break;
		break;
	}
	while(true) {
		if(X) break;
		if(Y) break;
		break;
	}
	while(true) {
		if(X) break;
		else if(Y) break;
		break;
	}
	while(true) {
		if(X) break;
		else {
			Consume();
			if(Y) break;
		}
		break;
	}
	// 終了
	return;
}

/**
 * 条件群の統合
 * @param A 第一条件
 * @param B 第二条件
 * @param C 第三条件
 */
void MergeChains(bool A, bool B, bool C) {
	if(A) if(B) if(C) Consume();
	if(A) Consume(); else if(B) Consume(); else if(C) Consume();
	// 終了
	return;
}

/**
 * 条件で導入する値を使う
 * @param Outer 外側の条件
 */
void BoundConditions(const bool Outer) {
	if(Outer) if(const int Value = Read(); Value) Consume(Value);
	if(Outer) Consume();
	else if(const int Value = Read(); Value) Consume();
	// 終了
	return;
}

/**
 * トークンの境界の照合
 */
void TokenBoundaries() {
	if(A) Z = X++ + Y;
	if(B) Z = X + ++Y;
	if(A) Z = X-- - Y;
	else if(B) Z = X - --Y;
	if(A) {
		Z = X++ + Y;
		Touch();
	}
	if(B) {
		Z = X + ++Y;
		Touch();
	}
	if(A) {
		Z = X-- - Y;
		Touch();
	} else if(B) {
		Z = X - --Y;
		Touch();
	}
	if(A) Z = X + Y;
	else if(B) Z = X + Y;
	if(A) { if(B) { Consume(); } }
	if(A) if(B) if(C) Consume();
	X += 1E0'1;
	X -= 1E+0'1;
	X += 1E-0'1;
	Consume(X >= B + 1E0'1);
	Consume(X <= B - 1E-0'1);
	Consume(B + 1E+0'1 <= X);
	Consume(B - 1E0'1 >= X);
	X += 1E0'0;
	Consume(X >= B + 1E0'0);
	Consume(X == 0E1'0);
	X += 0X1P0'1;
	Consume(X >= B + 0X1P-0'1);
	X -= 1E+0'1L;
	Consume(X >= B + 0X1P0'1L);
	if(A) Consume();
	if(B) Consume();
	if(C) Consume();
	if(A) Consume();
	else if(B) Consume();
	else if(C) Consume();
	// 終了
	return;
}
