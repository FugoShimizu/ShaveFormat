template<typename T>
class Container {
public:
	Container() : Size(0) {}
	void Add(const T &Item) {
		if(Size < Capacity) Items[Size++] = Item;
		else if(CanGrow()) {
			Grow();
			Items[Size++] = Item;
		}
	}
private:
	T Items[100];
	int Size;
	int Capacity = 100;
};

template<typename... T>
void Forward(T... Args) {
	Sink(Args...);
	int Count = sizeof...(T);
	Sink(std::forward<T>(Args)...);
}

[...xs = args] {}();

template <class... Ts>
struct T : public Ts... {
};
