void f(int x) {
	for (;;) /* forever */ {
		a();
		b();
	}
	while (x) /* w */ {
		a();
	}
	if (x) /* i */ {
		a();
		b();
	}
}

/**
 * 値の選択関数
 * @param Value 値
 * @return 選択した値
 */
int Select(int Value) {
	for(;;) {
		if(Value) {
			Value = 1;
			Value = 3;
		// 其の他の値
		} else return 0;
	}
}

