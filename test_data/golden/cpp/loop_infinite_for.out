/**
 *
 */
void f() {
	while(true) doThing();
}

/**
 *
 */
void g() {
	while(true) {
		doThing();
		if(stop) break;
	}
	return;
}

/**
 *
 */
void h() {
	// 既存の `while(true)` は不変
	while(true) doThing();
}

/**
 *
 */
void k() {
	// 範囲 for は対象外
	for(int &x : items) doThing(x);
	return;
}

/**
 *
 */
void labeled() {
	// label 付きでも変換 (但し C++ には label-break が無いので影響無し)
	while(true) if(done()) break;
	return;
}

/**
 *
 */
void LiteralWhile() {
	while(2) {}
}

/**
 *
 */
void LiteralFor() {
	for(; 0X2;) {}
}

/**
 *
 */
void LiteralDo() {
	do {} while(-1);
}

/**
 *
 */
void LiteralFloat() {
	while(1.0) {}
}

/**
 *
 */
void LiteralString() {
	while("x") {}
}

/**
 *
 */
void LiteralWrapped() {
	while(2) {}
}

/**
 *
 */
void LiteralZero() {
	while(0) {}
	return;
}

/**
 *
 */
void LiteralBreak() {
	while(2) break;
	return;
}
