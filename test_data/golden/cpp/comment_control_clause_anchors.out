// before private
private:

	int b;
};

/**
 *
 * @param x
 */
void f(int x) {
	while(true) /* forever */ {
		a();
		b();
	}
	while(x) /* w */ a();
	if(x) /* i */ {
		a();
		b();
	}
}

/**
 * 値の選択関数
 * @param Value 値
 * @return 選択した値
 */
int Select(int Value) {
	while(true) {
		if(Value) {
			Value = 1;
			Value = 3;
		// 其の他の値
		} else return 0;
	}
}

