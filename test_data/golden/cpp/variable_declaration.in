// === rule_var_decl_merge ===
void Foo() {
	const int A = 1;
	const int B = 2;
	const int C = 3;
	const bool X = false;
	const bool Y = true;
}

// === rule_var_decl_split ===
void Foo() {
	const int VeryLong11 = 1000, VeryLong22 = 2000, VeryLong33 = 3000, VeryLong44 = 4000, VeryLong55 = 5000, VeryLong66 = 6000, VeryLong77 = 7000;
}

// === rule_var_decl_split_trailing ===
void Foo() {
	const int VeryLong11 = 1000, VeryLong22 = 2000, VeryLong33 = 3000, VeryLong44 = 4000, VeryLong55 = 5000, VeryLong66 = 6000, VeryLong77 = 7000;  // 説明
}

// === rule_var_decl_trailing_concat ===
void Foo() {
	const int A = 1; // first
	const int B = 2;
	const int C = 3;
}

// === rule_var_decl_trailing_multi ===
void Foo() {
	const int X = 1; // x
	const int Y = 2; // y
}

/**
 * ネストした型の共有
 */
void NestedType(){
decltype(static_cast<decltype([]{})*>(nullptr)) FirstObjectWithSharedLambdaTypeAndLongIdentifier,
SecondObjectWithSharedLambdaTypeAndLongIdentifier;
}

/**
 * 別々のラムダ型
 */
void DistinctTypes(){
decltype([]{}) a;
decltype([]{}) b;
static_assert(!std::is_same_v<decltype(a),decltype(b)>);
}

template<int N> constexpr bool IsPositiveV<N + 1> = true;
template<typename T>
constexpr bool IsSameV<T, T> = true;
