namespace BitFields {
	enum class Flag : unsigned int { Off, On };

	struct S {
		int b : 1 = 0;
	};

	struct Widths {
		int a : 1 = 0;
		int b : 1 = 0;
		int c : 1 + 1 = 0;
		int d : sizeof(char) = 0;
		int e : sizeof(char) + 1 = 0;
	};

	class Types {
		bool a : 1 = false;
		unsigned int b : 1 = 0;
		Flag c : 1 = Flag::Off;
	};

	union U {
		int b : 1 = 0;
	};

	struct Initializers {
		int a : 1 = 0;
		int b : 1 { 0 };
		int c : 1 = { 0 };
		int d : 1;
		int e : sizeof(char) { 0 };
		int data[2] { 0, 0 };
	};

	struct Branches {
		int a : (true ? 1 : 2) = 0;
		int b : true ? 1 : 2 { 0 };
		int c : true ? 1 : 2;
	};

	struct WidthComma {
		int a : (1, 2) = 0;
		int b : (1, 2) { 0 };
		int c : (1, 2);
	};

	struct Comments {
		int a : /* 幅 */ 1 = /* 値 */ 0;
		int b : 1 /* 境界 */ { 0 };
	};
}
