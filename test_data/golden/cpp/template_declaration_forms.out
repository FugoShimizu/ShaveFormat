/**
 * 値の演算の保持
 * @param x 値
 * @param limit 境界
 */
void ValueOperators(int x, int limit) {
	Use(x >> limit);
	Use(x >= limit);
	return;
}

/**
 * 名前が値へ束縛された比較の保持
 * @param v 左辺
 * @param t 中央
 * @param m 右辺
 */
void ValueComparison(int v, int t, int m) {
	v < t > m;
	return;
}

template<typename T> class Container {
public:

	/**
	 *
	 */
	Container() : Size(0) {}

	/**
	 *
	 * @param Item
	 */
	void Add(const T &Item) {
		if(Size < Capacity) Items[Size++] = Item;
		else if(CanGrow()) {
			Grow();
			Items[Size++] = Item;
		}
		return;
	}

private:

	T Items[100];
	int Size;
	int Capacity = 100;
};

