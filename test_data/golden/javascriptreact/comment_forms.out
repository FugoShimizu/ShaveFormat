const A = () => (<div>{/* keep */}{}{}</div>);
const only = <div>{/* first */ /* second */ /* third */}</div>;
const value = <div>{0 /* first */ /* second */}</div>;
const A = () => (<div>{}<b>x</b></div>); // line comment // Two

/**
 * 値の取得関数
 * @return 取得した値
 */
function escapedElement() {
	const a = <span />;
	return \u{61};
}

/**
 * トークンの境界の照合
 */
function tokenBoundaries() {
	if(a) z = x++ + y;
	if(b) z = x + ++y;
	if(a) z = x-- - y;
	else if(b) z = x - --y;
	if(a) {
		z = x++ + y;
		touch();
	}
	if(b) {
		z = x + ++y;
		touch();
	}
	if(a) {
		z = x-- - y;
		touch();
	} else if(b) {
		z = x - --y;
		touch();
	}
	if(a) z = x + y;
	else if(b) z = x + y;
	// 終了
	return;
}

x === null || x === \u0075ndefined;
x == \u{75}ndefined || x == null;
x !== null && x !== un\u0064efined;
undefine\u0064 !== x && null !== x;
\u0075ndefined == x || null == x;
null != x && \u{75}ndefined != x;
x === null || x === \u0075ndefinedExtra;
x === \u0075ndefined || x === \u{75}ndefined;

