/**
 *
 * # Arguments
 * * `a`
 * * `b`
 * * `c`
 * * `p`
 * # Returns
 */
fn f(a: i32, b: i32, c: i32, p: &[i32]) -> i32 {
	let x = (a + b) * c;
	let y = p[(b + c) as usize] * a;
	return x + y;
}

/**
 *
 * # Returns
 */
fn h() -> i32 {
	return 5;
}

/**
 *
 * # Arguments
 * * `x`
 * # Returns
 */
fn f(x: i32) -> i32 {
	return {
		x
	} & 1;
}

/**
 *
 * # Returns
 */
fn g() -> i32 {
	let v = unsafe {
		h()
	} + 1;
	return loop {
		break 3
	} + v;
}

/**
 *
 */
fn main() {
	println!("{} {}", f(3), g());
	return;
}

/**
 *
