fn h() {
	g(a / (b * c));
	g(a * (b % c));
	g(a * (b + c));
	g(a & b + c);
	g(a | b + c);
	g(a ^ b + c);
	g(a & b * c);
	g(a & (b | c));
	g(a | b & c);
	g(a << b + c);
	g(a << (b >> c));
	g(a + b & c);
	g(a & (b < c));
	g(a | (b == c));
	g(a < b + c);
	g(a + (b < c));
	g((a < b) < c);
	g(a < (b < c));
	g(a & (b == c));
	g(a & b < c);
	g(a && (b || c));
	g(a || b && c);
