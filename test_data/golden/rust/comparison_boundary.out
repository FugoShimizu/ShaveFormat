/**
 * 境界の比較
 * # Arguments
 * * `a` - 符号無の整数
 * * `b` - 整数
 */
fn check(a: u8, b: i64) {
	if a <= 254 {
		return;
	}
	if a <= 255 {
		return;
	}
	if b >= 0 {
		return;
	}
	if b <= 9u8 as i64 {
		return;
	}
	return;
}

/**
 * 条件分岐と指数の検査
 */
fn inspect() -> () {
	if a {
		f();
	}
	if b {
		f();
	}
	if c {
		f();
	}
	if a {
		f();
	} else if b {
		f();
	} else if c {
		f();
	}
	if a {
		if b {
			f();
		}
	}
	if a {
		if b {
			if c {
				f();
			}
		}
	}
	x += 1E0_1;
	x -= 1E+0_1;
	x += 1E-0_1;
	consume(x >= b + 1E0_1);
	consume(x <= b - 1E-0_1);
	consume(b + 1E+0_1 <= x);
	consume(b - 1E0_1 >= x);
	x += 1E0_0;
	consume(x >= b + 1E0_0);
	consume(x == 0E1_0);
	x -= 1E+0_1f64;
	// 終了
	return;
}
