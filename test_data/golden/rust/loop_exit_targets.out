/// 多重ループの脱出
///
/// # Returns
/// 見付けた添字
fn outer_exit() -> i32 {
	let mut found = -1;
	'outer : for i in 0..10 {
		for j in 0..10 {
			if i * j > 20 {
				found = i;
				break 'outer;
			}
		}
	}
	return found;
}

/// 単一ループのラベル
///
/// # Returns
/// 常に 0
fn inner_exit() -> i32 {
	'inner : while true {
		break 'inner;
	}
	return 0;
}
