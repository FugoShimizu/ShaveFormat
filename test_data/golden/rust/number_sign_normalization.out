/**
 *
 * # Arguments
 * * `x`
 * * `c`
 * # Returns
 */
fn f(x: i32, c: bool) -> i32 {
	let a = --x;
	let b = !!c;
	return if b {
		a - -1
	} else {
		-!x
	};
}

/**
 *
 * # Arguments
 * * `text`
 * # Returns
 */
fn scan(text: &str) -> i32 {
	if !text.is_empty() {
		let open = '(';
		let raw = r#"a " ("#;
		let depth = 1;
		return depth;
	}
	return 0;
}
