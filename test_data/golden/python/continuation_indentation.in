def g(first_part, second_part, third_part, fourth_part, fifth_part, sixth_part, extra, trailing):
    body: str = first_part + "-" + second_part + "-" + third_part + "-" + fourth_part + "-" + fifth_part + "-" + sixth_part + "-" + extra
    label = first_part + "-" + second_part + "-" + third_part + "-" + fourth_part + "-" + fifth_part + "-" + sixth_part + "-" + trailing
    return body + label


def h():
    cases = (
        ("swift", "let v = a" + "".join(" ?? b%d * c%d << d%d" % (index, index, index) for index in range(3000)) + "\n"),
        ("swift", "let v = a" + "".join(" ?? b%d * c%d << d%d" % (index, index, index) for index in range(3000)) + "\nxxxxxxxxxxxxxxx"),
    )
    return cases


def k(token, opener, blocks):
    stacked: list[str] = re.findall(rf"([ \t\u3000]+){re.escape(opener)} ", token.text[len(opener):]) if opener not in blocks else []
    return stacked

