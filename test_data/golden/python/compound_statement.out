def classify(x):
	if x < 0:
		return -1
	elif x == 0:
		return 0
	elif x < 10:
		return 1
	return 2

def safe_div(a, b):
	try:
		return a / b
	except ZeroDivisionError:
		return None
	finally:
		cleanup()

class Box:
	def __init__(self, value):
		self.value = value
		return

	def double(self):
		return self.value * 2

