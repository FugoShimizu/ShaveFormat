def f():
	a()
	return

# end f
def g(x):
	if x:
		return 1

def h():
	"""Doc."""

def k():
	yield 1

class A:
	def __init__(self):
		self.x = 1
		return

	def m(self) -> None:
		def inner():
			b()
			return
		return

# end inner
def nested():
	def inner():
		g()
		return
	# t1
	# t2
	return inner

def imported_member():
	from other import sys
	sys.exit()
	return

def imported_alias():
	from other import sys as sys
	sys.exit()
	return

def imported_module():
	import sys
	sys.exit()

def imported_callable_module():
	import exit
	exit()
	return

def imported_dotted():
	import other.sys
	other.sys.exit()
	return

def imported_dotted_alias():
	import other.sys as sys
	sys.exit()
	return

def imported_module_alias():
	import sys as sys
	sys.exit()

def imported_standard_member():
	from sys import exit
	exit()

def standard_alias():
	import sys as system
	system.exit()

def standard_member_alias():
	from sys import exit as leave
	leave()

def reassigned_exit():
	from sys import exit as leave
	leave = resume
	leave()
	return

def caught_exit():
	import sys
	try:
		sys.exit()
	except SystemExit:
		pass
	return

def site_names():
	exit()
	quit()
	return

def exit_value_error():
	import sys
	try:
		sys.exit(0)
	except ValueError:
		print("x")

def exit_exception():
	import sys
	try:
		sys.exit(0)
	except Exception:
		print("x")

def exit_base_exception():
	import sys
	try:
		sys.exit(0)
	except BaseException:
		print("x")
	return

def exit_finally():
	import sys
	try:
		sys.exit(0)
	finally:
		return

def exit_unknown(handler):
	import sys
	try:
		sys.exit(0)
	except handler:
		pass
	return

def division_caught():
	try:
		1 / 0
		return
	except ZeroDivisionError:
		print("caught")
	return

def argument_caught():
	import sys
	try:
		sys.exit(1 / 0)
	except ZeroDivisionError:
		print("caught")
	return

def exit_suppressed():
	import sys
	from contextlib import suppress
	with suppress(SystemExit):
		sys.exit()
	return

def return_not_suppressed(manager):
	with manager:
		return

def required_condition() -> None:
	import sys
	if sys.exit():
		print(1)

def ordinary_condition() -> None:
	import sys
	if maybe():
		print(1)
	return

def required_argument() -> None:
	import sys
	print(sys.exit())

def required_initializer() -> None:
	import sys
	value = sys.exit()
	print(value)

def required_loop() -> None:
	import sys
	while sys.exit():
		print(1)

def short_circuit(a) -> None:
	import sys
	a and sys.exit()
	return

def both_branches(a) -> None:
	import sys
	sys.exit() if a else sys.exit(1)

def one_branch(a) -> None:
	import sys
	sys.exit() if a else 0
	return

def deferred_lambda() -> None:
	import sys
	action = lambda: sys.exit()
	print(action)
	return

def required_receiver():
	import sys
	sys.exit().x

def required_list():
	import sys
	[sys.exit()]

def required_default():
	import sys
	def action(x = sys.exit()):
		pass

def required_decorator():
	import sys
	@decorate(sys.exit())
	def action():
		pass

def required_manager():
	import sys
	with sys.exit():
		pass

def required_expansion():
	import sys
	print(*sys.exit())

def required_interpolation():
	import sys
	text = f"{sys.exit()}"

def required_iteration_source():
	import sys
	values = [value for value in sys.exit()]

def conditional_exit(flag) -> None:
	if flag:
		from sys import exit
	exit(1)

