def reassigned_attribute():
	import sys
	sys.exit = lambda: None
	sys.exit()
	return

def reassigned_import_alias():
	import sys as s
	s.exit = lambda: None
	s.exit()
	return

def reassigned_receiver_alias():
	import sys
	alias = sys
	alias.exit = lambda: None
	sys.exit()
	return

def receiver_alias_after_reassignment():
	import sys
	alias = sys
	sys.exit = lambda: None
	alias.exit()
	return

def callee_alias_after_reassignment():
	import sys
	sys.exit = lambda: None
	g = sys.exit
	g()
	return

def reassigned_tuple():
	import sys
	sys.exit, other = lambda: None, 1
	sys.exit()
	return

def reassigned_chain():
	import sys
	sys.exit = other = lambda: None
	sys.exit()
	return

def conditional_reassignment():
	import sys
	if ready:
		sys.exit = lambda: None
	sys.exit()
	return

def captured_original_callee():
	import sys
	g = sys.exit
	sys.exit = lambda: None
	g()

def supplied_chain():
	import sys
	sys.exit = other = lambda: None
	sys.exit()
	return

def supplied_chain_alias():
	import sys
	g = other = sys.exit = lambda: None
	g()
	return

def captured_chain_callee():
	import sys
	g = other = sys.exit
	sys.exit = lambda: None
	g()

def conditionally_supplied_loop():
	import sys
	g = lambda: None
	for value in []:
		g = sys.exit
	g()
	return

def conditionally_supplied_while():
	import sys
	g = lambda: None
	while False:
		g = sys.exit
	g()
	return

def conditionally_supplied_handler():
	import sys
	g = lambda: None
	try:
		pass
	except ValueError:
		g = sys.exit
	g()
	return

def deleted_function_alias():
	import sys
	g = sys.exit
	del g
	try:
		g()
	except NameError:
		pass
	return

def deleted_module_alias():
	import sys as s
	del s
	try:
		s.exit()
	except NameError:
		pass
	return

def deleted_member_alias():
	import sys
	s = sys
	del sys.exit
	try:
		s.exit()
	except AttributeError:
		pass
	return

def captured_before_deletion():
	import sys
	g = sys.exit
	del sys.exit
	g()

def catch_type_exit() -> None:
	import sys
	try:
		sys.exit()
	except (BaseException, sys.exit()):
		pass

def catch_type_exit_alias() -> None:
	from sys import exit as stop
	try:
		stop()
	except (SystemExit, stop()):
		pass

def catch_type_exit_outer() -> None:
	import sys
	try:
		try:
			sys.exit()
		except (BaseException, sys.exit()):
			pass
	except SystemExit:
		pass
	return

def literal_while():
	while 2:
		pass

def literal_negative():
	while -1:
		pass

def literal_hex():
	while 0X2:
		pass

def literal_float():
	while 1.0:
		pass

def literal_string():
	while "x":
		pass

def literal_wrapped():
	while 2:
		pass

def literal_zero():
	while 0:
		pass
	return

def literal_break():
	while 2:
		break
	return

def forward_local_module() -> None:
	import sys
	def inner() -> None:
		sys.exit()
		sys: object = object()
	return

def forward_local_alias() -> None:
	from sys import exit as leave
	def inner() -> None:
		leave()
		leave: object = object()
	return
