# ホスト側の生成と通常の構築は，文法名・入力パス・生成先の対応を共有する
if(CMAKE_SCRIPT_MODE_FILE)
	if(NOT SHAVEFMT_SOURCE_DIR)
		get_filename_component(SHAVEFMT_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
	endif()
	if(NOT SHAVEFMT_PARSER_OUTPUT_DIR)
		message(FATAL_ERROR "SHAVEFMT_PARSER_OUTPUT_DIR is required")
	endif()
	find_program(TREE_SITTER_CLI NAMES tree-sitter tree-sitter.cmd REQUIRED)
	find_program(NODE_EXECUTABLE NAMES node node.exe REQUIRED)
endif()

# tree-sitter 言語パーサー（文法毎に独立した静的ライブラリ）
# 各文法が独自の `tree_sitter/parser.h`（ABI バージョン依存）を持つ為，取込経路を文法単位に閉じる事でヘッダ衝突を回避する
# 文法を拡張するスクリプト tools/prepare<文法名>.mjs が在る文法は，拡張した文法から parser.c を生成する
# 古い glibc の構築環境では，ホスト側で生成済の文法の場所を SHAVEFMT_PREGENERATED_<文法名の大文字>_DIR で受け取る
set(SHAVEFMT_PREGENERATED_ROOT "" CACHE PATH "Pre-generated parser root directory")
set(SHAVEFMT_PREGENERATED_CPP_DIR "" CACHE PATH "Pre-generated C++ parser directory")
set(SHAVEFMT_PREGENERATED_HTML_DIR "" CACHE PATH "Pre-generated HTML parser directory")
set(SHAVEFMT_PREGENERATED_SCSS_DIR "" CACHE PATH "Pre-generated SCSS parser directory")
set(SHAVEFMT_PREGENERATED_SWIFT_DIR "" CACHE PATH "Pre-generated Swift parser directory")
set(SHAVEFMT_PREGENERATED_TSX_DIR "" CACHE PATH "Pre-generated TSX parser directory")
set(SHAVEFMT_PREGENERATED_TYPESCRIPT_DIR "" CACHE PATH "Pre-generated TypeScript parser directory")
# 第３引数は１つの文法の集まりから複数の文法を作る時の対象名（省略時は文法名：tree-sitter-typescript の typescript / tsx）
# 第４引数の ORIGINAL は，拡張を適用しない比較用の文法を指定する
function(add_ts_grammar GRAMMAR_NAME SRC_SUBDIR)
	if(ARGC GREATER 2)
		set(TARGET_SUFFIX "${ARGV2}")
	else()
		string(REPLACE "-" "_" TARGET_SUFFIX "${GRAMMAR_NAME}")
	endif()
	# 同じ配布元の方言も，生成物と比較用のターゲットを混用しない
	string(REGEX REPLACE "_original$" "" GENERATED_NAME "${TARGET_SUFFIX}")
	set(SRC_DIR "${SHAVEFMT_SOURCE_DIR}/vendor/tree-sitter-${GRAMMAR_NAME}/${SRC_SUBDIR}")
	file(GLOB GRAMMAR_SOURCES
		"${SRC_DIR}/parser.c" "${SRC_DIR}/scanner.c" "${SRC_DIR}/scanner.cc" "${SRC_DIR}/schema.generated.cc"
	)
	string(SUBSTRING "${GRAMMAR_NAME}" 0 1 NAME_HEAD)
	string(SUBSTRING "${GRAMMAR_NAME}" 1 -1 NAME_TAIL)
	string(TOUPPER "${NAME_HEAD}" NAME_HEAD)
	string(TOUPPER "${GENERATED_NAME}" NAME_UPPER)
	set(PREPARE_SCRIPT "${SHAVEFMT_SOURCE_DIR}/tools/prepare${NAME_HEAD}${NAME_TAIL}.mjs")
	set(PREGENERATED_DIR "${SHAVEFMT_PREGENERATED_${NAME_UPPER}_DIR}")
	if(SHAVEFMT_PREGENERATED_ROOT AND NOT PREGENERATED_DIR)
		set(PREGENERATED_DIR "${SHAVEFMT_PREGENERATED_ROOT}/${GENERATED_NAME}")
	endif()
	if(EXISTS "${PREPARE_SCRIPT}" AND NOT (ARGC GREATER 3 AND ARGV3 STREQUAL "ORIGINAL"))
		set_property(GLOBAL APPEND PROPERTY SHAVEFMT_EXTENDED_GRAMMARS "${GRAMMAR_NAME}|${SRC_SUBDIR}|${TARGET_SUFFIX}")
	endif()
	set(IS_ORIGINAL FALSE)
	if(ARGC GREATER 3 AND ARGV3 STREQUAL "ORIGINAL")
		set(IS_ORIGINAL TRUE)
		set(PREPARE_SCRIPT "")
		set(PREGENERATED_DIR "${SHAVEFMT_PREGENERATED_ROOT}/${GENERATED_NAME}/original")
	endif()
	# 拡張の入口は prepare の１つに保ち，外部スキャナーの入力は同じ生成先へ先にコピーする
	set(SCANNER_FILES "")
	foreach(SCANNER_FILE scanner.c scanner.cc)
		if(EXISTS "${SRC_DIR}/${SCANNER_FILE}" AND NOT IS_ORIGINAL)
			list(APPEND SCANNER_FILES "${SCANNER_FILE}")
		endif()
	endforeach()
	if(CMAKE_SCRIPT_MODE_FILE)
		if(NOT EXISTS "${PREPARE_SCRIPT}" AND NOT IS_ORIGINAL)
			return()
		endif()
		set(GENERATED_DIR "${SHAVEFMT_PARSER_OUTPUT_DIR}/${GENERATED_NAME}")
		if(IS_ORIGINAL)
			set(GENERATED_DIR "${GENERATED_DIR}/original")
			set(GRAMMAR_JSON "${SRC_DIR}/grammar.json")
		else()
			file(MAKE_DIRECTORY "${GENERATED_DIR}")
			foreach(SCANNER_FILE IN LISTS SCANNER_FILES)
				file(COPY "${SRC_DIR}/${SCANNER_FILE}" DESTINATION "${GENERATED_DIR}")
			endforeach()
			execute_process(COMMAND "${NODE_EXECUTABLE}" "${PREPARE_SCRIPT}" "${SRC_DIR}/grammar.json" "${GENERATED_DIR}"
				COMMAND_ERROR_IS_FATAL ANY)
			set(GRAMMAR_JSON "${GENERATED_DIR}/grammar.json")
		endif()
		execute_process(COMMAND "${TREE_SITTER_CLI}" generate --abi 14 "${GRAMMAR_JSON}" -o "${GENERATED_DIR}"
			COMMAND_ERROR_IS_FATAL ANY)
		return()
	endif()
	if(EXISTS "${PREPARE_SCRIPT}" OR IS_ORIGINAL)
		if(PREGENERATED_DIR AND (NOT IS_ORIGINAL OR SHAVEFMT_PREGENERATED_ROOT))
			set(GENERATED_DIR "${PREGENERATED_DIR}")
			set(GENERATED_FILES parser.c tree_sitter/parser.h)
			list(APPEND GENERATED_FILES ${SCANNER_FILES})
			foreach(GENERATED_FILE IN LISTS GENERATED_FILES)
				if(NOT EXISTS "${GENERATED_DIR}/${GENERATED_FILE}")
					message(FATAL_ERROR "Missing pre-generated ${GRAMMAR_NAME} file: ${GENERATED_DIR}/${GENERATED_FILE}")
				endif()
			endforeach()
		else()
			find_program(TREE_SITTER_CLI NAMES tree-sitter tree-sitter.cmd REQUIRED)
			find_program(NODE_EXECUTABLE NAMES node node.exe REQUIRED)
			set(GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/${GENERATED_NAME}")
			set(GRAMMAR_JSON "${GENERATED_DIR}/grammar.json")
			set(PREPARE_BYPRODUCTS "${GRAMMAR_JSON}")
			set(PREPARE_COMMAND COMMAND "${CMAKE_COMMAND}" -E make_directory "${GENERATED_DIR}")
			set(PREPARE_DEPENDS "${PREPARE_SCRIPT}" "${SHAVEFMT_SOURCE_DIR}/tools/grammarShape.mjs")
			file(GLOB SCANNER_HEADERS "${SRC_DIR}/*.h" "${SRC_DIR}/../../common/*.h")
			list(APPEND PREPARE_DEPENDS ${SCANNER_HEADERS})
			foreach(SCANNER_FILE IN LISTS SCANNER_FILES)
				list(APPEND PREPARE_BYPRODUCTS "${GENERATED_DIR}/${SCANNER_FILE}")
				list(APPEND PREPARE_COMMAND COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${SRC_DIR}/${SCANNER_FILE}" "${GENERATED_DIR}/${SCANNER_FILE}")
				list(APPEND PREPARE_DEPENDS "${SRC_DIR}/${SCANNER_FILE}")
			endforeach()
			list(APPEND PREPARE_COMMAND COMMAND "${NODE_EXECUTABLE}" "${PREPARE_SCRIPT}" "${SRC_DIR}/grammar.json" "${GENERATED_DIR}")
			if(IS_ORIGINAL)
				set(GENERATED_DIR "${GENERATED_DIR}/original")
				set(GRAMMAR_JSON "${SRC_DIR}/grammar.json")
				set(PREPARE_COMMAND "")
				set(PREPARE_BYPRODUCTS "")
				set(PREPARE_DEPENDS "")
			endif()
			add_custom_command(
				OUTPUT "${GENERATED_DIR}/parser.c" "${GENERATED_DIR}/tree_sitter/parser.h"
				BYPRODUCTS ${PREPARE_BYPRODUCTS} "${GENERATED_DIR}/node-types.json"
					"${GENERATED_DIR}/tree_sitter/alloc.h" "${GENERATED_DIR}/tree_sitter/array.h"
				${PREPARE_COMMAND}
				COMMAND "${TREE_SITTER_CLI}" generate --abi 14 "${GRAMMAR_JSON}" -o "${GENERATED_DIR}"
				DEPENDS "${SRC_DIR}/grammar.json" ${PREPARE_DEPENDS} "${TREE_SITTER_CLI}" "${NODE_EXECUTABLE}"
				VERBATIM
			)
		endif()
		list(REMOVE_ITEM GRAMMAR_SOURCES "${SRC_DIR}/parser.c")
		list(APPEND GRAMMAR_SOURCES "${GENERATED_DIR}/parser.c")
		foreach(SCANNER_FILE IN LISTS SCANNER_FILES)
			list(REMOVE_ITEM GRAMMAR_SOURCES "${SRC_DIR}/${SCANNER_FILE}")
			list(APPEND GRAMMAR_SOURCES "${GENERATED_DIR}/${SCANNER_FILE}")
		endforeach()
	endif()
	set(TARGET_NAME "ts_${TARGET_SUFFIX}")
	add_library(${TARGET_NAME} STATIC ${GRAMMAR_SOURCES})
	# 大きな生成済の構文表は通常の最適化で１度翻訳し，各検査のリンクで再最適化しない
	set_target_properties(${TARGET_NAME} PROPERTIES INTERPROCEDURAL_OPTIMIZATION FALSE)
	if(GENERATED_DIR)
		target_include_directories(${TARGET_NAME} PRIVATE "${GENERATED_DIR}")
	endif()
	target_include_directories(${TARGET_NAME} PRIVATE ${SRC_DIR})
	# スキャナーの配列と直接の libc 呼出を同じ確保器へ接続する（C の翻訳単位だけへ前提ヘッダを渡す）
	target_compile_definitions(${TARGET_NAME} PRIVATE TREE_SITTER_REUSE_ALLOCATOR)
	if(MSVC)
		target_compile_options(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:C>:/FI${CMAKE_SOURCE_DIR}/src/Util/ParserAllocatorC.h>")
	else()
		target_compile_options(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:C>:-include${CMAKE_SOURCE_DIR}/src/Util/ParserAllocatorC.h>"
		)
	endif()
	# 生成したパーサーと共に人が書いた外部スキャナーを含む為，スキャナーも防御の対象にする
	foreach(HARDENING_FLAG IN LISTS SHAVEFMT_C_HARDENING)
		target_compile_options(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:C>:${HARDENING_FLAG}>")
	endforeach()
	foreach(HARDENING_FLAG IN LISTS SHAVEFMT_HARDENING)
		target_compile_options(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${HARDENING_FLAG}>")
	endforeach()
	# 境界検査が最も要るのは手書きのスキャナーを含む此処の為，実行ファイルと同じ定義を渡す
	foreach(HARDENING_DEFINITION IN LISTS SHAVEFMT_C_HARDENING_DEFINITIONS)
		target_compile_definitions(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:C>:${HARDENING_DEFINITION}>")
	endforeach()
	foreach(HARDENING_DEFINITION IN LISTS SHAVEFMT_HARDENING_DEFINITIONS)
		target_compile_definitions(${TARGET_NAME} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${HARDENING_DEFINITION}>")
	endforeach()
	# 生成物の parser.c は対象外の儘とし，人が書いたスキャナーにだけ警告を掛ける（未使用引数は上流の書き方で直せない為に除く）
	if(NOT MSVC)
		set(SCANNER_C "${SRC_DIR}/scanner.c")
		if(GENERATED_DIR AND "scanner.c" IN_LIST SCANNER_FILES)
			set(SCANNER_C "${GENERATED_DIR}/scanner.c")
		endif()
		set_source_files_properties("${SCANNER_C}"
			TARGET_DIRECTORY ${TARGET_NAME}
			PROPERTIES COMPILE_OPTIONS "${SHAVEFMT_C_WARNINGS};-Wno-unused-parameter")
		set(SCANNER_CPP "${SRC_DIR}/scanner.cc")
		if(GENERATED_DIR AND "scanner.cc" IN_LIST SCANNER_FILES)
			set(SCANNER_CPP "${GENERATED_DIR}/scanner.cc")
		endif()
		set_source_files_properties("${SCANNER_CPP}"
			TARGET_DIRECTORY ${TARGET_NAME}
			PROPERTIES COMPILE_OPTIONS "${SHAVEFMT_WARNINGS};-Wno-unused-parameter")
	endif()
	# 静的ライブラリでも動的リンクされる shavefmt 経由で extern される為 PIC 必須
	set_target_properties(${TARGET_NAME} PROPERTIES POSITION_INDEPENDENT_CODE ON)
	if(NOT IS_ORIGINAL)
		if(GENERATED_DIR)
			set(PARSER_PATH "${GENERATED_DIR}/parser.c")
		else()
			set(PARSER_PATH "${SRC_DIR}/parser.c")
		endif()
		set_property(GLOBAL APPEND PROPERTY SHAVEFMT_GRAMMAR_PARSERS "${TARGET_SUFFIX}\t${PARSER_PATH}\n")
	endif()
endfunction()

add_ts_grammar(c src)
add_ts_grammar(cpp src)
add_ts_grammar(c-sharp src)
add_ts_grammar(java src)
add_ts_grammar(go src)
add_ts_grammar(rust src)
add_ts_grammar(kotlin src)
add_ts_grammar(swift src)
# tree-sitter-php は PHP 単体 (php_only) と HTML 混在 (php) の２文法を持ち，後者が `<?php ... ?>` を含む実ファイルを扱える
add_ts_grammar(php php/src)
add_ts_grammar(javascript src)
# TypeScript は JSX の有無で文法が分かれる（`.ts` の型アサーション `<T>x` は `.tsx` の文法では JSX と読まれる）
add_ts_grammar(typescript typescript/src)
add_ts_grammar(typescript tsx/src tsx)
add_ts_grammar(ruby src)
add_ts_grammar(python src)
add_ts_grammar(json src)
add_ts_grammar(html src)
# CSS / SCSS は tree-sitter-scss で統一する（SCSS は CSS の上位集合で，純 CSS も解析出来る）
add_ts_grammar(scss src)

# 比較用は同じ元の文法定義から生成し，vendor の生成済の表の有無・更新状態に依存させない
get_property(EXTENDED_GRAMMARS GLOBAL PROPERTY SHAVEFMT_EXTENDED_GRAMMARS)
foreach(GRAMMAR IN LISTS EXTENDED_GRAMMARS)
	string(REPLACE "|" ";" GRAMMAR "${GRAMMAR}")
	list(GET GRAMMAR 0 GRAMMAR_NAME)
	list(GET GRAMMAR 1 SRC_SUBDIR)
	list(GET GRAMMAR 2 TARGET_SUFFIX)
	if(BUILD_TESTING OR CMAKE_SCRIPT_MODE_FILE)
		add_ts_grammar(${GRAMMAR_NAME} ${SRC_SUBDIR} ${TARGET_SUFFIX}_original ORIGINAL)
	endif()
endforeach()
