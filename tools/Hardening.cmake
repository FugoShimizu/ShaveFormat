include(CheckCCompilerFlag)
if(CMAKE_CXX_COMPILER_LOADED)
	include(CheckCXXCompilerFlag)
endif()
set(SHAVEFMT_C_HARDENING "")
set(SHAVEFMT_HARDENING "")
if(MSVC)
	set(SHAVEFMT_C_HARDENING /GS /guard:cf)
	set(SHAVEFMT_HARDENING /GS /guard:cf)
else()
	# 受け付けるが働かないフラグ（Apple の clang の `-fstack-clash-protection`）は警告をエラーに格上げして落とす
	# 警告の名前は clang 固有で，GCC は未知の名前をエラーとし全てのフラグを非対応と判定する為，clang でのみ格上げする
	# 呼出側の値を壊さない様に控えてから足し，検査の後に戻す
	set(SHAVEFMT_SAVED_REQUIRED_FLAGS "${CMAKE_REQUIRED_FLAGS}")
	set(SHAVEFMT_C_REQUIRED_FLAGS "${SHAVEFMT_SAVED_REQUIRED_FLAGS}")
	set(SHAVEFMT_CXX_REQUIRED_FLAGS "${SHAVEFMT_SAVED_REQUIRED_FLAGS}")
	if(CMAKE_C_COMPILER_ID MATCHES "Clang")
		string(APPEND SHAVEFMT_C_REQUIRED_FLAGS " -Werror=unused-command-line-argument")
	endif()
	if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
		string(APPEND SHAVEFMT_CXX_REQUIRED_FLAGS " -Werror=unused-command-line-argument")
	endif()
	# `-fcf-protection` は x86 専用，`-mbranch-protection` は arm64 専用の為，双方を候補に置いて対応する側だけを採る
	set(SHAVEFMT_HARDENING_CANDIDATES -fcf-protection=full -fstack-clash-protection -fstack-protector-strong)
	# Apple の arm64 の巻戻しはシグネチャした戻り番地を読めず，`-mbranch-protection` を付けた関数を通る C++ の例外を捕捉出来なく為る為に候補から除く
	if(NOT APPLE)
		list(APPEND SHAVEFMT_HARDENING_CANDIDATES -mbranch-protection=standard)
	endif()
	foreach(HARDENING_FLAG IN LISTS SHAVEFMT_HARDENING_CANDIDATES)
		string(MAKE_C_IDENTIFIER "SHAVEFMT_C_HAS${HARDENING_FLAG}" C_HARDENING_VAR)
		string(MAKE_C_IDENTIFIER "SHAVEFMT_CXX_HAS${HARDENING_FLAG}" HARDENING_VAR)
		set(CMAKE_REQUIRED_FLAGS "${SHAVEFMT_C_REQUIRED_FLAGS}")
		check_c_compiler_flag("${HARDENING_FLAG}" ${C_HARDENING_VAR})
		if(CMAKE_CXX_COMPILER_LOADED)
			set(CMAKE_REQUIRED_FLAGS "${SHAVEFMT_CXX_REQUIRED_FLAGS}")
			check_cxx_compiler_flag("${HARDENING_FLAG}" ${HARDENING_VAR})
		endif()
		if(${C_HARDENING_VAR})
			list(APPEND SHAVEFMT_C_HARDENING ${HARDENING_FLAG})
		endif()
		if(CMAKE_CXX_COMPILER_LOADED AND ${HARDENING_VAR})
			list(APPEND SHAVEFMT_HARDENING ${HARDENING_FLAG})
		endif()
	endforeach()
	set(CMAKE_REQUIRED_FLAGS "${SHAVEFMT_SAVED_REQUIRED_FLAGS}")
endif()

# 配布環境で必要な防御は，非対応として黙って外さず構成を失敗させる
# Apple の arm64 の戻り番地の認証は C++ の例外と両立しない為，Linux の arm64 だけで必須とする
if(MSVC)
	set(SHAVEFMT_REQUIRED_HARDENING /GS /guard:cf)
else()
	set(SHAVEFMT_REQUIRED_HARDENING -fstack-protector-strong)
	if(CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux)$" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|x64)$")
		list(APPEND SHAVEFMT_REQUIRED_HARDENING -fcf-protection=full)
	endif()
	if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|x64|aarch64|arm64|ARM64)$")
		list(APPEND SHAVEFMT_REQUIRED_HARDENING -fstack-clash-protection)
		if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
			list(APPEND SHAVEFMT_REQUIRED_HARDENING -mbranch-protection=standard)
		endif()
	endif()
endif()
list(SORT SHAVEFMT_REQUIRED_HARDENING)
foreach(HARDENING_FLAG IN LISTS SHAVEFMT_REQUIRED_HARDENING)
	list(FIND SHAVEFMT_C_HARDENING "${HARDENING_FLAG}" SHAVEFMT_C_HARDENING_INDEX)
	if(SHAVEFMT_C_HARDENING_INDEX EQUAL -1)
		message(FATAL_ERROR "Required C hardening flag is missing: ${HARDENING_FLAG}")
	endif()
	if(CMAKE_CXX_COMPILER_LOADED)
		list(FIND SHAVEFMT_HARDENING "${HARDENING_FLAG}" SHAVEFMT_CXX_HARDENING_INDEX)
		if(SHAVEFMT_CXX_HARDENING_INDEX EQUAL -1)
			message(FATAL_ERROR "Required C++ hardening flag is missing: ${HARDENING_FLAG}")
		endif()
	endif()
endforeach()

# C と C++ の既定の境界検査を同じ手順で確かめ，各呼出側へ追加する定義を返す
# 処理系が既に決めた水準を下げず，最適化する構成だけを対象にする
function(shavefmt_fortify_definition LANGUAGE OUTPUT)
	set(${OUTPUT} "" PARENT_SCOPE)
	if(MSVC)
		return()
	endif()
	# 関数内の変更は呼出元へ伝わらない為，検査用のフラグを外へ残さない
	string(APPEND CMAKE_REQUIRED_FLAGS " -O2")
	set(SHAVEFMT_FORTIFY_SOURCE "#ifndef _FORTIFY_SOURCE\n#error none\n#endif\nint main(void) { return 0; }")
	set(SHAVEFMT_FORTIFY_RESULT "SHAVEFMT_${LANGUAGE}_HAS_DEFAULT_FORTIFY")
	if(LANGUAGE STREQUAL "C")
		include(CheckCSourceCompiles)
		check_c_source_compiles("${SHAVEFMT_FORTIFY_SOURCE}" ${SHAVEFMT_FORTIFY_RESULT})
	else()
		include(CheckCXXSourceCompiles)
		check_cxx_source_compiles("${SHAVEFMT_FORTIFY_SOURCE}" ${SHAVEFMT_FORTIFY_RESULT})
	endif()
	if(NOT ${SHAVEFMT_FORTIFY_RESULT})
		set(${OUTPUT} "$<$<NOT:$<CONFIG:Debug>>:_FORTIFY_SOURCE=2>" PARENT_SCOPE)
	endif()
endfunction()
shavefmt_fortify_definition(C SHAVEFMT_C_HARDENING_DEFINITIONS)
set(SHAVEFMT_HARDENING_DEFINITIONS "")
if(CMAKE_CXX_COMPILER_LOADED)
	shavefmt_fortify_definition(CXX SHAVEFMT_HARDENING_DEFINITIONS)
endif()
